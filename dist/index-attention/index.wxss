.collect-container {
    position: fixed;
    width: 100%;
    height: 100%;
    padding: 0 50rpx;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 9999;
    background-color: rgba(0,0,0,0.8);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

.collect-container .guide-img {
    width: 140rpx;
    height: 114rpx;
    position: absolute;
    top: 20rpx;
    right: 200rpx;
}

.collect-container .step-1 {
    display: flex;
    align-items: center;
    width: 100%;
    position: absolute;
    top: 100rpx;
}

.collect-container .float-text {
    font-size: 28rpx;
    color: #fff;
    width: 232rpx;
}

.collect-container .top-img {
    width: 98rpx;
    height: 52rpx;
}

.collect-container .middle-img {
    width: 600rpx;
    height: 366rpx;
    position: absolute;
    top: 300rpx;
    margin-left: 20rpx;
}

.collect-container .step-2 {
    position: absolute;
    top: 230rpx;
    width: 100%;
}

.collect-container .step-3 {
    position: absolute;
    top: 732rpx;
    width: 100%;
}

.collect-container .define-btn {
    width: 332rpx;
    height: 72rpx;
    border-radius: 36rpx;
    border: 2rpx solid #fff;
    color: #fff;
    font-size: 28rpx;
    text-align: center;
    line-height: 72rpx;
    position: absolute;
    bottom: 200rpx;
    left: calc(50% - 166rpx);
}

.collect-container .beout-btn {
    width: 332rpx;
    height: 70rpx;
    color: #59a9d5;
    font-size: 28rpx;
    text-align: center;
    line-height: 70rpx;
    position: absolute;
    bottom: 80rpx;
    left: calc(50% - 166rpx);
}