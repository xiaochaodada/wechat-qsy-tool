.btn {
    padding: 0;
    height: 100rpx;
    font-size: 28rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 150rpx;
    margin: 40rpx;
    background: none;
    border-radius: 10rpx;
}

.btn image {
    float: left;
    width: 60rpx;
    height: 60rpx;
}

.btn view {
    float: left;
    width: 100%;
    text-align: center;
}

.active-btn {
    background: rgb(148,218,240);
}

.remind {
    width: 90%;
    height: 300rpx;
    background: white;
    position: absolute;
    left: 5%;
    top: 30%;
    border: 2rpx solid #FF4900;
}

.remind text {
    display: block;
    padding: 20rpx;
    font-size: 36rpx;
    line-height: 50rpx;
}

.remark_bottom {
    width: 100%;
    height: 11%;
    border-top: 1rpx solid #fcdfd3;
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    bottom: 0rpx;
    z-index: 1000;
    background: none;
}

.remark_bottom button {
    font-size: 28rpx;
    line-height: 36rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: none;
}

.remark_bottom image {
    width: 65rpx;
    height: 65rpx;
    margin: 10rpx;
}

.remark_bottom button::after {
    border: none;
}

.hint {
    color: red;
    font-size: 28rpx;
    width: 100%;
    position: absolute;
    top: 10rpx;
    left: 3%;
}

.kuoda {
    z-index: 100;
    width: 40rpx;
    height: 40rpx;
    position: absolute;
    bottom: -13rpx;
    right: -13rpx;
    background: rgba(255,255,255,0.4);
    background: yellowgreen;
}