.userinfo {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.userinfo-avatar {
    width: 128rpx;
    height: 128rpx;
    margin: 20rpx;
    border-radius: 50%;
}

.userinfo-nickname {
    color: #aaa;
}

.usermotto {
    margin-top: 200px;
}

.img-list {
    width: 47.3vw;
    display: inline-block;
    height: 27vw;
    margin: 6rpx;
}

.nselect {
    display: inline-block;
    margin: 20rpx;
    width: 40%;
    text-align: center;
}

.selected {
    display: inline-block;
    margin: 20rpx;
    width: 40%;
    text-align: center;
    background: rgb(138,200,230);
    color: white;
    border-radius: 20rpx;
}

.imgTy {
    font-size: 32rpx;
    width: 40%;
    text-align: center;
    display: inline-block;
}

.imgTyed {
    font-size: 32rpx;
    width: 30%;
    text-align: center;
    display: inline-block;
    background: rgb(138,200,230);
    color: white;
    border-radius: 20rpx;
}

.main {
    position: fixed;
    top: 0rpx;
    left: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    background: white;
    z-index: 10;
}

.scroll-box {
    height: 80rpx;
    line-height: 80rpx;
    width: 90%;
    white-space: nowrap;
    margin: 0 auto;
}

.scroll-view_x {
    width: 90%;
    display: flex;
    align-items: center;
    overflow: hidden;
    height: 100%;
    border: 1rpx solid red;
}

.tui-city-scroll {
    height: 100rpx;
    line-height: 80rpx;
    width: 100%;
    white-space: nowrap;
}

.img-item {
    display: inline-block;
    font-size: 28rpx;
    text-align: center;
    margin: 5rpx 10rpx;
    width: 25%;
}

.img-item-selected {
    display: inline-block;
    font-size: 28rpx;
    text-align: center;
    margin: 5rpx 10rpx;
    width: 25%;
    height: 40rpx;
    line-height: 40rpx;
    background: rgb(138,200,230);
    color: white;
    border-radius: 20rpx;
}

.sixteen-and-n {
    position: relative;
    width: 47.3vw;
    display: inline-block;
    height: 27vw;
    margin: 6rpx;
    box-shadow: 0rpx 0rpx 20rpx 0rpx #ddd;
}

.n-and-sixteen {
    position: relative;
    width: 32%;
    margin: 5rpx;
    height: 53vw;
    display: inline-block;
    box-shadow: 0rpx 0rpx 20rpx 0rpx #ddd;
}

.one {
    position: relative;
    width: 47vw;
    height: 47vw;
    margin: 1%;
    display: inline-block;
    box-shadow: 0rpx 0rpx 20rpx 0rpx #ddd;
}

.paster {
    position: relative;
    width: 200rpx;
    height: 200rpx;
    margin: 25rpx;
    display: inline-block;
    box-shadow: 0rpx 0rpx 20rpx 0rpx #ddd;
}