page {
    color: #757474;
    overflow: hidden;
}

.contentWarp {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    margin: auto;
}

.remind {
    padding: 20rpx;
    color: #757474;
    font-size: 34rpx;
    position: absolute;
    top: 20%;
    width: 85vw;
    left: 5vw;
    background: white;
    border: 2rpx solid #EB6057;
}

.box {
    position: absolute;
    z-index: 100;
    width: 100vw;
    height: 89vh;
    top: 0;
    left: 0;
    margin: auto;
    overflow: hidden;
}

.touchWrap {
    transform-origin: center;
    position: absolute;
    z-index: 100;
}

.imgWrap {
    box-sizing: border-box;
    width: 100%;
    transform-origin: center;
    float: left;
    border: 5rpx transparent dashed;
}

.imgWrap image {
    float: left;
}

.touchActive .x {
    display: block;
}

.touchActive .o {
    display: block;
}

.x {
    position: absolute;
    top: -25rpx;
    left: -25rpx;
    z-index: 500;
    display: none;
    width: 50rpx;
    height: 50rpx;
    overflow: hidden;
    font-weight: bold;
    color: #d1e3f1;
}

.o {
    position: absolute;
    bottom: -25rpx;
    right: -25rpx;
    width: 50rpx;
    height: 50rpx;
    text-align: center;
    display: none;
    overflow: hidden;
    font-weight: bold;
    color: #d1e3f1;
}

.active {
    background-color: rgb(78,114,151);
}

.active view {
    border: none;
}

.touchActive {
    z-index: 400;
}

.bottom {
    border-top: 1rpx solid #b34762;
    height: 10vh;
    position: fixed;
    bottom: 10rpx;
    width: 100%;
    margin-top: 40rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

.bottom button {
    font-size: 28rpx;
    padding: 0;
    display: flex;
    line-height: 30rpx;
    flex-direction: column;
    align-items: center;
    width: 90rpx;
    background: none;
}

button::after {
    border: none;
}

.bottom button image {
    margin: 10rpx;
    width: 60rpx;
    height: 60rpx;
}

.slider {
    z-index: 1000;
    width: 90%;
    height: 100rpx;
    position: fixed;
    bottom: 10vh;
    left: 5%;
    box-shadow: 0rpx 0rpx 15rpx 0rpx rgb(43,146,231);
    background: rgb(43,146,231,0.5);
    border-radius: 10rpx;
    color: white;
}