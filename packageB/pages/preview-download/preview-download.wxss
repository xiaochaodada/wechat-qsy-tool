.preview-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
}

.container {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
}

.tips {
    font-size: 13px;
    margin-top: 10px;
}
.main {
    display: flex;
    flex-direction: column;
}

.preview-head {
    text-align: left;
    width: 100%;
}

.page-head-2 .btn-area {
    margin-top: 0;
}

.has-margin {
    margin: 10px;
    align-items: center;
    justify-content: center;
}
.long-text {
    word-break: break-all;
}

.has-margin-tb {
    margin: 10px 0;
}

.preview {
    text-align: center;
    width: 100%;
    box-sizing: border-box;
}

.preview image,.preview video {
    width: 100%;
    height: 250px;
    display: block;
}
.mute {
    color: grey;
    font-size: 14px;
}
.preview-middle {
    margin-top: 5px;
}
.has-margin-lr {
    margin-left: 10px;
    margin-right: 10px;
}
button {
}

.btn-area {
    margin-top: 30rpx;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
}

.md-btn-area {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: stretch;
    width: 100%;
}

.md-btn-area button {
    flex-grow: 1;
    text-align: center;
    justify-content: center;
}

.md-btn-area button:nth-child(odd) {
    margin-right: 5px;
}

.md-btn-area button:nth-child(even) {
    margin-left: 5px;
    margin-right: 1px;
}

.btn-circle {
    display: block;
    width: 100px;
    height: 100px;
    line-height: 100px;
    border: 2px solid #f5f5f5;
    border-radius: 50%;
    color: #f5f5f5;
    text-align: center;
    background: #464646;
    box-shadow: 0 0 3px gray;
}

.btn-circle1 {
    background-color: #f8f8f8;
    border-radius: 50%;
    border: 2px solid #dfdfdf;
    display: inline-block;
    color: #000;
    font-size: 17px;
    width: 50px;
    height: 50px;
    line-height: 50px;
    text-align: center;
    box-shadow: 0 0 3px gray;
}

.highlight {
    font-weight: bold;
}

.highlight {
    background-color: #ffffc7;
}