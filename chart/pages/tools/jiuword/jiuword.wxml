<view class="page">
    <view class="word_box flex_between">
        <block>
            <block wx:if="{{bgColorSel[1]===-1}}">
                <block wx:for="{{9}}" wx:key="{{index}}">
                    <view class="word_item flex_center" style="color:{{bgColor3[ bgColorSel[2] ]}};background-color:{{bgColor[ bgColorSel[0] ]}}">{{words[index]}}</view>
                </block>
            </block>
            <block wx:else>
                <block wx:for="{{9}}" wx:key="{{index}}">
                    <view class="word_item flex_center" style="color:{{bgColor3[ bgColorSel[2] ]}}; background: url({{bgColor2[ bgColorSel[1] ]}}) no-repeat center center;">{{words[index]}}</view>
                </block>
            </block>
        </block>
    </view>
    <view class="bd">
        <view class="input_box flex_start">
            <input bindblur="confirmInput" bindconfirm="confirmInput" bindinput="confirmInput" class="input_word" maxlength="9" placeholder="请点击这里输入文字" placeholderClass="word_place"></input>
        </view>
        <view class="bd_bg flex_start">
            <image class="icon_canvas" src="icon_canvas.png"></image>
            <movable-area class="move_area flex_start">
                <movable-view class="move_view flex_start" direction="horizontal" style="width:{{bgColor.length*72}}rpx;">
                    <block wx:for="{{bgColor}}" wx:key="{{index}}">
                        <block>
                            <block wx:if="{{index===bgColorSel[0]}}">
                                <view class="move_item move_item_sel" style="background-color:{{item}}"></view>
                            </block>
                            <block wx:elif="{{item=='#fff'}}">
                                <view bindtap="selBgColor" class="move_item move_item_white" data-index="{{index}}" data-item="0" style="background-color:{{item}}"></view>
                            </block>
                            <block wx:else>
                                <view bindtap="selBgColor" class="move_item" data-index="{{index}}" data-item="0" style="background-color:{{item}}"></view>
                            </block>
                        </block>
                    </block>
                </movable-view>
            </movable-area>
        </view>
        <view class="bd_bg_2 flex_start">
            <image class="icon_canvas icon_canvas_2" src="icon_canvas.png"></image>
            <movable-area class="move_area flex_start">
                <movable-view class="move_view flex_start" direction="horizontal" style="width:{{bgColor2.length*72}}rpx;">
                    <block wx:for="{{bgColor2}}" wx:key="{{index}}">
                        <block>
                            <block wx:if="{{index===bgColorSel[1]}}">
                                <image class="move_item move_item_sel" src="{{item}}"></image>
                            </block>
                            <block wx:else>
                                <image bindtap="selBgColor" class="move_item" data-index="{{index}}" data-item="1" data-url="{{item}}" src="{{item}}"></image>
                            </block>
                        </block>
                    </block>
                </movable-view>
            </movable-area>
        </view>
        <view class="bd_text flex_start">
            <image class="icon_canvas" src="icon_bg_text.png"></image>
            <movable-area class="move_area flex_start">
                <movable-view class="move_view flex_start" direction="horizontal" style="width:{{bgColor3.length*72}}rpx;">
                    <block wx:for="{{bgColor3}}" wx:key="{{index}}">
                        <block>
                            <block wx:if="{{index===bgColorSel[2]}}">
                                <view class="move_item move_item_sel" style="background-color:{{item}}"></view>
                            </block>
                            <block wx:elif="{{item=='#fff'}}">
                                <view bindtap="selBgColor" class="move_item move_item_white" data-index="{{index}}" data-item="2" style="background-color:{{item}}"></view>
                            </block>
                            <block wx:else>
                                <view bindtap="selBgColor" class="move_item" data-index="{{index}}" data-item="2" style="background-color:{{item}}"></view>
                            </block>
                        </block>
                    </block>
                </movable-view>
            </movable-area>
        </view>
    </view>
</view>
<view class="btn_ft_wrap flex_between">
    <button bindtap="saveImage" class="btn_ft">保存拼图</button>
    <button class="btn_ft" openType="share">分享好友</button>
</view>
<canvas canvasId="myCanvas" class="canvas"></canvas>