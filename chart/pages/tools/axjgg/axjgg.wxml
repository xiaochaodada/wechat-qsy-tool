<view style=" width:100%; color:azure;">
    <view style="width:100%; display:flex; justify-content:center; margin-top:5px;">
        <view class="cutBox" style="position: relative; width: {{boxWidth+6}}px; height: {{boxWidth+6}}px; box-shadow:0px 0px 3px  #D9D9D9;">
            <block wx:for="{{img_list}}">
                <view bindtap="MaxImgClick" id="{{item.id}}" style="width: {{width}}px;height: {{width}}px; float:left; background-color: {{bg_color}}; border: 1px solid white;">
                    <block wx:for="{{item.img_arr}}">
                        <image mode="aspectFill" src="{{item.url}}" style="width: {{minWidth}}px;height: {{minWidth}}px; float:left; background-color:{{item.voided==1?'#6A5ACD':''}};">{{item.id}}</image>
                    </block>
                </view>
            </block>
        </view>
    </view>
    <view style="display:flex; margin-top: 4px;">
        <view class="info" style="float:left; margin-left:5px; width:100%;">Tips: 点击对应九宫格选择图片</view>
        <view style="position: absolute; display:flex;  justify-content:center; right:0px; width:110px;">
            <view>
                <image src="edit.png" style="width: 20px; height: 20px;"></image>
            </view>
            <input bindinput="input_number" confirmType="done" maxlength="2" placeholder="输入数字" style="margin-left:5px;color: black;" type="number"></input>
        </view>
    </view>
    <view style="display:flex; justify-content:center; margin-top: 4px;">
        <block wx:for="{{templet}}" wx:for-item="templet_item">
            <view bindtap="selectTemplet" id="{{templet_item.id}}" style="border: {{curr_templet==templet_item.id?'1':'0'}}px solid red; width: 96rpx;height: 93rpx; float:left;margin-left:20rpx;">
                <block wx:for="{{templet_item.imgArray}}" wx:for-item="imgArray_item">
                    <view style="background-color:#FF69B4; width:30rpx; height:30rpx; float:left; margin-bottom:3rpx; margin-left:3rpx;">
                        <block wx:for="{{imgArray_item.value}}" wx:for-item="j">
                            <view style="width: {{10}}rpx;height: {{10}}rpx;float:left; background-color:{{j==1?'#6A5ACD':''}};"></view>
                        </block>
                    </view>
                </block>
            </view>
        </block>
    </view>
    <view style="margin-top: 10px;">
        <view style="display:flex; justify-content:center; color:  grey;">
            <radio-group bindchange="radioChange" class="radio-group">
                <block wx:for="{{items}}">
                    <label class="radio">
                        <block>
                            <block wx:if="{{show_lock=='Y'&&item.name=='C'}}">
                                <image bindtap="bindtap_yttm" src="lock.png" style=" float:left;border-radius: 50%;width:40rpx; height:40rpx;"></image>
                            </block>
                        </block>
                        <block>
                            <block wx:if="{{show_lock=='Y'&&item.name=='C'}}">
                                <view bindtap="bindtap_yttm" style=" float:left;">{{item.value}}</view>
                            </block>
                        </block>
                        <block>
                            <block wx:if="{{show_lock!='Y'||item.name!='C'}}">
                                <radio checked="{{item.checked}}" value="{{item.name}}">{{item.value}}</radio>
                            </block>
                        </block>
                    </label>
                </block>
            </radio-group>
        </view>
    </view>
    <view style="margin-top: 10px;">
        <view bindtap="setColor" class="btn_setColor" style="float:left;">设置背景色</view>
        <block>
            <block wx:if="{{!show_shouquan}}">
                <button bindtap="generate" class="btn_gen" style="float:right;">保存相册</button>
            </block>
        </block>
        <block>
            <block wx:if="{{show_shouquan}}">
                <button class="btn_gen" openType="openSetting" style="float:right;">请授权保存</button>
            </block>
        </block>
    </view>
</view>
<canvas canvasId="myCanvas_A" style="position:absolute; border: 1px solid red; width: {{boxWidth*4}}px;height: {{boxWidth*4}}px; top:-9999px; left:-9999px; "></canvas>
<view style="margin-top: 60px; width:100%; display:flex; justify-content:center;">
    <view style=" width: {{boxWidth+6}}px;" wx:if="{{mode != 0 && config.advertisements.box_ad && config.user_information.vip !='1'}}">
        <!-- 盒子广告 -->
        <ad adTheme="white" adType="grid" gridCount="5" gridOpacity="0.8" unitId="{{config.advertisements.box_ad}}"></ad>
    </view>
</view>
<block>
    <block wx:if="{{showSetColor}}">
        <view style=" position:fixed; bottom: 0px; background-color: rgba(0,0,0,0.5);">
            <view catchtap="temp_clack" style="position:relative; bottom: 0; width:100%;  ">
                <view style=" position: fixed;  z-index: 1002; overflow: auto; background-color: white; bottom: 0; width:100%; ">
                    <view style="width:{{windowWidth-5}}px; text-align:right;">
                        <icon bindtap="clossSetColor" type="clear"></icon>
                    </view>
                    <view style="width:100%; display:flex; justify-content:center;text-align: center; ">
                        <block wx:for="{{color_list}}" wx:key="item">
                            <text bindtap="set_color" class="sel_color" id="{{item.id}}" style="float:left; background-color:{{item.color}}; color:{{item.color}};"></text>
                        </block>
                    </view>
                    <view style="display:flex; justify-content:center;text-align: center;">
                        <view style="width: 90%;">
                            <text style="float:left;">R</text>
                            <slider showValue activeColor="red" bindchange="sliderRchange" bindchanging="sliderRchange" max="255" min="0" value="{{bg_color_r}}"></slider>
                            <text style="float:left;">G</text>
                            <slider showValue bindchange="sliderGchange" bindchanging="sliderGchange" max="255" min="0" value="{{bg_color_g}}"></slider>
                            <text style="float:left;">B</text>
                            <slider showValue activeColor="blue" bindchange="sliderBchange" bindchanging="sliderBchange" max="255" min="0" value="{{bg_color_b}}"></slider>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </block>
</block>
<block>
    <block wx:if="{{maskFlag}}">
        <view catchtap="closeMask" class="mask">
            <view catchtap="temp_clack" style="position:relative; bottom: 0; width:100%; ">
                <view style=" position: fixed; text-align: center; z-index: 1002; overflow: auto; background-color: white; bottom: 0; width:100%; ">
                    <view style="width:100%;" wx:if="{{mode != 0 && config.advertisements.index_video_ad && config.user_information !='1'}}">
                        <!-- 视频广告 -->
                        <ad adTheme="white" adType="video" unitId="{{config.advertisements.index_video_ad}}"></ad>
                    </view>
                    <block>
                        <block wx:if="{{show_ggts=='1'}}">
                            <view style="margin-bottom: 20rpx;">{{show_ggtsy}}</view>
                        </block>
                    </block>
                    <icon size="70" style="margin-top: 20rpx; margin-bottom: 20rpx;" type="success"></icon>
                    <view style="margin-bottom: 20rpx;">保存成功, 请到系统相册查看</view>
                    <view style="display: flex; align-items: center; justify-content: center;  width:100%; height: 90rpx;border-top: 1px solid #D9D9D9;">
                        <button openType="share" style=" display:block;padding-left:0px;padding-right:0px;background-color: rgba(255,255,255,0);  width:100%;">
                            转发给好友
                        </button>
                    </view>
                    <view catchtap="closeMask" class="closeMask">关闭</view>
                </view>
            </view>
        </view>
    </block>
</block>

<button open-type='share'>
    <image class="add-wrap" src="/images/shares.jpg"></image>
</button>