.container {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 30rpx 0;
    box-sizing: border-box;
}
form {
    width: 90%;
    margin: 10px auto;
}

.itemTitle {
    font-size: 17pt;
    width: 90%;
}

.seachInput {
    border-radius: 3pt;
    font-size: 13pt;
    height: 30pt;
    line-height: 30pt;
    padding: 5px;
    background-color: #F5F4F9;
}

.itemButtom {
    padding: 5px 5px 5px 0px;
}

.seachButtom {
    width: 60pt;
    height: 30pt;
    line-height: 30pt;
    font-size: 13pt;
    color: #fff;
    border-radius: 3pt;
    background-color: #1AAD19;
    float: left;
}

.resetButtom {
    width: 60pt;
    height: 30pt;
    line-height: 30pt;
    font-size: 13pt;
    color: #fff;
    border-radius: 3pt;
    background-color: #E64340;
    margin-left: 5px;
    float: left;
}

.paragraphs {
    width: 90%;
    margin-top: 20px;
    font-size: 14pt;
    text-align: left;
    color: #353535;
    background-color: #f7f7f9;
    border: 1px solid #ccc;
    border-radius: 3px;
    padding: 6px 0px;
}

.paragraph {
    margin-left: 5px;
    line-height: 25px;
}

.hint {
    font-size: 12px;
    color: #808080;
    margin: 15px;
}

.tool-info {
    padding-top: 2rem;
    width: 90%;
}

.tool-info .title {
    font-size: 14px;
    font-weight: bold;
    padding-bottom: 5px;
}

.tool-info .info {
    font-size: 12px;
    line-height: 1.6;
    padding-bottom: 10px;
    color: #666;
}