.mask-nouse {
    position: fixed;
    top: 0%;
    width: 100%;
    height: 100%;
    background: white;
    opacity: 0.9;
}

.videomask {
    position: fixed;
    top: 0%;
    width: 100%;
    height: 100%;
    background: white;
}

.videomask video {
    width: 100%;
    height: 100%;
}

button::after {
    border: none;
}

button {
    box-sizing: border-box!important;
}