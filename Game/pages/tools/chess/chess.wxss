.control {
    margin: 0 auto;
}


page {
    background: #e69138;
}

canvas {
    margin: 0 auto;
    margin-top: 15%;
    background-size: 100% auto;
    background-repeat: no-repeat;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url('data:image/jpg;base64,');
}

.btn-wrap {
    display: flex;
    margin: 0 auto;
    margin-top: 15%;
    background-size: 100% auto;
    background-repeat: no-repeat;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60px;
}

.btn-wrap div {
    margin: 0 10px;
}

div>span {
    width: 60px;
    height: 60px;
    margin: 0 auto;
    margin-top: 15px;
    background-size: 100% auto;
    background-repeat: no-repeat;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

#result-wrap {
    text-align: center;
}

view {
    margin: 0 auto;
}

view>span {
    color: green;
    line-height: 56px;
    font-size: 15px;
    width: 50px;
    display: inline-block;
}

p {
    color: green;
    display: block;
    margin-top: -10px;
    margin-bottom: -30px;
}

a {
    display: block;
    margin-top: -38px;
    color: ghostwhite;
    font-size: 20px;
    font-weight: bold;
}

.button {
    color: gray;
    border-radius: 5px;
    cursor: pointer;
    width: 60px;
    height: 60px;
    margin-top: 15px;
    background-size: 100% auto;
    background-image: url('https://lg-hfhuj3u2-1256953294.cos.ap-shanghai.myqcloud.com/green.png');
}

.bannerAd {
    margin-top: 10px;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100px;
    margin-bottom: 5px;
}

.box1 {
    display: flex;
    margin-top: 20rpx;
}

.box2 {
    display: flex;
}

button::after {
    border: none!important;
}

button {
    background-color: white;
    padding-left: 0!important;
    color: orange;
}

.bs1 {
    background: #af7200;
    border-radius: 20rpx;
    padding: 10rpx;
    color: #fff;
}

.bs2 {
    margin-top: 10%;
    background: #af7200;
    border-radius: 50rpx;
    padding: 10rpx;
    color: #fff;
    height: 100rpx;
    line-height: 100rpx;
    width: 200rpx;
    text-align: center;
}

.xf2 {
    box-sizing: inherit!important;
}