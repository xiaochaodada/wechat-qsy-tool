<view class="container">
    <ad wx:if="{{mode != 0 && config.advertisements.box_ad && config.user_information.vip !='1'}}" adTheme="white" adType="grid" gridCount="5" gridOpacity="0.8" unitId="{{config.advertisements.box_ad}}"></ad>


    <view style="width:90%;margin-left:5%;display:flex;flex-direction:row;justify-content:space-between;color:white">
        <text>得分：{{score}}</text>
        <text>时间{{time}}</text>
    </view>
    <view class="box">
        <block wx:for="{{block.color}}" wx:key="key">
            <view bindtap="nextBlock" class="inbox" data-id="{{index}}" style="width:{{100/block.lv}}%;height:{{100/block.lv}}%;background:{{item}}"></view>
        </block>
    </view>
</view>
<view class="modal" hidden="{{isHidden}}">
    <view class="content">
        <text class="modal-result">{{score}}</text>
        <button bindtap="again" class="modal-btn" style="background:rgb(39, 114, 226)">再测一次</button>
    </view>
</view>
<button open-type='share'>
    <image class="add-wrap" src="/images/shares.jpg"></image>
</button>