.circle-wrap {
    margin-top: 80rpx;
    position: relative;
    width: 872rpx;
    height: 872rpx;
}

@-webkit-keyframes scale {
    0% {
        transform: scale(0.1,0.1);
    }

    60% {
        transform: scale(1.05,1.05);
    }

    80% {
        transform: scale(.95,.95);
    }

    100% {
        transform: scale(1,1);
    }
}

@keyframes scale {
    0% {
        transform: scale(0.1,0.1);
    }

    60% {
        transform: scale(1.05,1.05);
    }

    80% {
        transform: scale(.95,.95);
    }

    100% {
        transform: scale(1,1);
    }
}

.circle-image {
    width: 100%;
    height: 100%;
    transform: rotate(0deg);
    transition: transform 2.5s cubic-bezier(0,0,.6,1);
    transition: transform 2.5s cubic-bezier(0,0,.6,1),-webkit-transform 2.5s cubic-bezier(0,0,.6,1);
    transition: transform 2.5s cubic-bezier(0,0,.6,1),-webkit-transform 2.5s cubic-bezier(0,0,.6,1);
    transform-origin: 50% 50%;
}

.circle-image.scale {
    animation: scale 1s;
}

.play-image {
    position: absolute;
    width: 316rpx;
    height: 320rpx;
    left: 50%;
    top: 50%;
    transform: translate3d(-50%,-50%,0);
}

.selected-image {
    position: absolute;
    width: 508rpx;
    height: 316rpx;
    top: -120rpx;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
}

@-webkit-keyframes jump {
    0% {
        transform: translate3d(-50%,0,0);
    }

    25% {
        transform: translate3d(-50%,-10rpx,0);
    }

    50% {
        transform: translate3d(-50%,0,0);
    }

    75% {
        transform: translate3d(-50%,20rpx,0);
    }

    100% {
        transform: translate3d(-50%,0,0);
    }
}

@keyframes jump {
    0% {
        transform: translate3d(-50%,0,0);
    }

    25% {
        transform: translate3d(-50%,-10rpx,0);
    }

    50% {
        transform: translate3d(-50%,0,0);
    }

    75% {
        transform: translate3d(-50%,20rpx,0);
    }

    100% {
        transform: translate3d(-50%,0,0);
    }
}

.selected-image.end {
    animation: jump 1s linear infinite;
}

.selected-text {
    position: absolute;
    top: 96rpx;
    left: 50%;
    transform: translateX(-50%);
    color: #000;
    font-weight: bold;
    font-size: 40rpx;
}

.punishment {
    color: #fff;
    font-size: 32rpx;
    position: absolute;
    width: 180rpx;
    text-align: right;
    left: 50%;
    top: 50%;
    transform: translate3d(-50%,-50%,0);
}

.punishment-0 {
    transform: translate3d(calc(-50% + 200rpx),-50%,0) rotate(0deg);
}

.punishment-1 {
    transform: translate3d(calc(-50% + 180rpx),calc(-50% - 76rpx),0) rotate(-22.5deg);
}

.punishment-2 {
    transform: translate3d(calc(-50% + 140rpx),calc(-50% - 140rpx),0) rotate(-45deg);
}

.punishment-3 {
    transform: translate3d(calc(-50% + 80rpx),calc(-50% - 186rpx),0) rotate(-67.5deg);
}

.punishment-4 {
    transform: translate3d(-50%,calc(-50% - 200rpx),0) rotate(-90deg);
}

.punishment-5 {
    transform: translate3d(calc(-50% + 180rpx),calc(-50% + 76rpx),0) rotate(22.5deg);
}

.punishment-6 {
    transform: translate3d(calc(-50% + 140rpx),calc(-50% + 140rpx),0) rotate(45deg);
}

.punishment-7 {
    transform: translate3d(calc(-50% + 80rpx),calc(-50% + 186rpx),0) rotate(67.5deg);
}

.punishment-8 {
    transform: translate3d(-50%,calc(-50% + 200rpx),0) rotate(90deg);
}

.punishment-9 {
    transform: translate3d(calc(-50% - 74rpx),calc(-50% + 184rpx),0) rotate(112.5deg);
}

.punishment-10 {
    transform: translate3d(calc(-50% - 140rpx),calc(-50% + 142rpx),0) rotate(135deg);
}

.punishment-11 {
    transform: translate3d(calc(-50% - 180rpx),calc(-50% + 76rpx),0) rotate(157.5deg);
}

.punishment-12 {
    transform: translate3d(calc(-50% - 200rpx),-50%,0) rotate(180deg);
}

.punishment-13 {
    transform: translate3d(calc(-50% - 180rpx),calc(-50% - 76rpx),0) rotate(202.5deg);
}

.punishment-14 {
    transform: translate3d(calc(-50% - 140rpx),calc(-50% - 142rpx),0) rotate(225deg);
}

.punishment-15 {
    transform: translate3d(calc(-50% - 74rpx),calc(-50% - 184rpx),0) rotate(247.5deg);
}

