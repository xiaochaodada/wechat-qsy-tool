@import "../app.wxss";

.pair {
    background: url(data:image/png;base64,) no-repeat 0 0;
    background-size: 100% 346rpx;
    width: 100%;
    padding: 20rpx 0 0;
    position: relative;
}

.pair_b {
    background: url(data:image/png;base64,) no-repeat 0 0;
    background-size: 100% 142rpx;
    width: 100%;
    height: 142rpx;
    position: relative;
    left: 0;
    bottom: 0;
}

.pair .pair_title {
    background: rgba(255,228,228,0.4);
    width: 180rpx;
    height: 56rpx;
    border-radius: 56rpx;
    line-height: 56rpx;
    text-align: center;
    box-shadow: 0 2px 6px rgba(255,157,71,0.25);
    margin: 0 auto;
    font-size: 32rpx;
    color: #ff9d47;
    font-weight: bold;
}

.pair .box {
    background: url(data:image/jpeg;base64,) repeat-x 0 0;
    position: relative;
    background-size: auto 100%;
    width: 622rpx;
    border-radius: 14rpx;
    margin: 84rpx auto 0;
    padding: 0 36rpx 70rpx;
}

.pair .box .box_bgt {
    background: url(data:image/png;base64,) no-repeat 0 0;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 220rpx;
    background-size: 100% 220rpx;
}

.pair .box .box_bgb {
    background: url(data:image/png;base64,) no-repeat 0 0;
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 192rpx;
    background-size: 100% 192rpx;
}

.pair .box .box_t {
    padding: 0 24rpx;
    margin-bottom: 30rpx;
}

.pair .box .box_t .box_li {
    float: left;
    width: 210rpx;
    margin: -120rpx 0rpx 0;
}

.pair .box .box_t .box_li .box_libg {
    background: url(data:image/png;base64,) no-repeat center bottom;
    background-size: 100rpx 20rpx;
    height: 220rpx;
}

.pair .box .box_t .box_li .box_libg .box_liimg {
    width: 210rpx;
    height: 210rpx;
}

.pair .box .box_t .box_li .box_litext {
    color: #e05846;
    font-size: 32rpx;
    display: block;
    text-align: center;
    font-weight: bold;
    margin-top: 5rpx;
}

.pair .box .box_t .box_line {
    float: left;
}

.pair .box .box_t .box_line .box_lineimg {
    width: 150rpx;
    height: 72rpx;
}

.pair .box .content {
    color: #fff5f5;
    font-size: 30rpx;
    line-height: 60rpx;
    text-indent: 65rpx;
    display: block;
}

.btns {
    width: 100%;
    text-align: center;
    height: 82rpx;
    margin-top: 60rpx;
}

.sharebtn {
    padding: 0;
    margin: 0;
}

.pair .pair_btn,.sharebtn {
    width: 300rpx;
    height: 82rpx;
    text-align: center;
    line-height: 82rpx;
    border-radius: 82rpx;
    color: #fff;
    font-size: 36rpx;
    background: -webkit-gradient(linear,72% 100%,68% 0%,from(#fc9a43),to(#ffc881));
    box-shadow: 0 2px 6px rgba(228,130,57,0.5);
    position: relative;
    z-index: 55;
    display: inline-block;
    vertical-align: top;
    margin: 0 25rpx;
}

.mini {
    position: relative;
    padding-top: 70rpx;
}