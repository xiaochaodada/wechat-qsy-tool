@import "../app.wxss";

.pair {
    background: url(data:image/png;base64,) no-repeat 0 0;
    background-size: 100% 346rpx;
    padding-top: 60rpx;
}

.pair .pair_b {
    background: url(data:image/png;base64,) no-repeat 0 0;
    background-size: 100% 142rpx;
    width: 100%;
    height: 142rpx;
    position: fixed;
    left: 0;
    bottom: 0;
}

.pair .pair_title {
    text-align: center;
}

.pair .pair_title .pair_timg {
    width: 340rpx;
    height: 120rpx;
}

.pair .pair_ul {
    margin-top: 166rpx;
}

.pair .pair_ul .pair_li {
    float: left;
    width: 222rpx;
    margin: 0 75rpx;
}

.pair .pair_ul .pair1 .pair_bg {
    background: url(data:image/png;base64,) no-repeat 0 0;
}

.pair .pair_ul .pair2 .pair_bg {
    background: url(data:image/png;base64,) no-repeat 0 0;
}

.pair .pair_ul .pair_li .pair_bg {
    width: 222rpx;
    height: 222rpx;
    background-size: 222rpx;
    position: relative;
}

.pair .pair_ul .pair_li .pair_bg .pair_img {
    width: 222rpx;
    height: 222rpx;
    position: absolute;
    left: 0;
    top: -68rpx;
}

.pair .pair_ul .pair_li .pair_text {
    width: 150rpx;
    height: 56rpx;
    border-radius: 56rpx;
    line-height: 56rpx;
    text-align: center;
    margin: 12rpx auto 0;
    color: #fff;
    font-size: 32rpx;
    padding-left: 20rpx;
}

.pair .pair_ul .pair1 .pair_text {
    background: #98b5f9;
}

.pair .pair_ul .pair2 .pair_text {
    background: #ff96a4;
}

.pair .pair_ul .pair_li .pair_text .ico_arrow {
    background: url(data:image/png;base64,) no-repeat 0 0;
    background-size: 24rpx;
    width: 24rpx;
    height: 24rpx;
    float: right;
    margin: 18rpx 20rpx 0 0;
}

.pair .pair_btn {
    width: 360rpx;
    height: 82rpx;
    text-align: center;
    line-height: 82rpx;
    border-radius: 82rpx;
    color: #fff;
    font-size: 36rpx;
    background: -webkit-gradient(linear,72% 100%,68% 0%,from(#fc9a43),to(#ffc881));
    box-shadow: 0 2px 6px rgba(228,130,57,0.35);
    margin: 96rpx auto 0;
}

.float_box .f_main {
    padding-top: 50rpx;
}

::-webkit-scrollbar {
    width: 0rpx;
    height: 0rpx;
    color: transparent;
    background-color: rgba(255,255,255,0);
}

@media screen and (min-height:700px) {
    .pair .pair_ul {
        margin-top: 226rpx;
    }

    .pair .pair_btn {
        margin: 136rpx auto 0;
    }
}