@import "../common/loadings.wxss";
@import "./htmlweb.wxss";
@import "./list.wxss";
page {
    background: #f2f4f6;
}

.list {
    display: flex;
    align-items: center;
    background: #fff;
    padding: 24rpx 20rpx;
    border-bottom: 1px #eee solid;
}

.left {
    height: 220rpx;
}

.left image {
    width: 220rpx;
    height: 220rpx;
    border-radius: 10rpx;
}

.right {
    padding-left: 20rpx;
    width: 470rpx;
}

.txt {
    font-size: 28rpx;
    color: #000;
    line-height: 48rpx;
}

.buyBtn {
    padding-top: 36rpx;
    display: flex;
    justify-content: space-between;
    float: right;
}

.price {
    font-size: 26rpx;
    color: #666;
}

.price text {
    font-size: 32rpx;
    color: #e02e24;
    font-weight: bold;
}

.buyBtn button {
    width: 200rpx;
    height: 70rpx;
    background: #e02e24;
    font-size: 30rpx;
    color: #fff;
    line-height: 70rpx;
    text-align: center;
    margin: 0;
}

.buyBtn button::after {
    border: none;
}

.d_mask {
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.6);
    position: fixed;
    left: 0;
    top: 0;
    z-index: 999;
}

.donghua {
    position: fixed;
    left: 12.6%;
    top: 30%;
    background: #fff;
    border-radius: 20rpx;
    width: 560rpx;
    text-align: center;
    padding: 60rpx 0;
    z-index: 999;
}

.donghua image {
    width: 426rpx;
    height: 677rpx;
}

.donghua button {
    width: 460rpx;
    height: 88rpx;
    background: #1cb4ff;
    border-radius: 50rpx;
    font-size: 30rpx;
    color: #fff;
    line-height: 88rpx;
    text-align: center;
    margin-top: 46rpx;
}

.donghua button::after {
    border: none;
}

.list2 {
    display: flex;
    justify-content: space-between;
    background: #fff;
    margin-bottom: 20rpx;
    padding: 22rpx 20rpx;
}

.title2 {
    font-size: 30rpx;
    color: #000;
    line-height: 48rpx;
}

.right2 {
    height: 150rpx;
}

.right2 image {
    width: 240rpx;
    height: 150rpx;
    margin-left: 20rpx;
    border-radius: 10rpx;
}





.gg10 {
    margin-left: 25rpx;
    position: relative;
    width: 702rpx;
    height: 550rpx;
    float: left;
    border-radius: 14rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.icon-list {
    padding: 0 24rpx 24rpx;
    overflow: hidden;
}

.swiper-nav {
    padding: 5rpx 0;
    height: 56rpx;
    width: 100%;
    position: fixed;
    z-index: 99;
    background: #fff;
    background-color: #fff;
    white-space: nowrap;
    -webkit-tap-highlight-color: rgba(0,0,0,0);
    /* width: 706rpx; */
}

.swiper-nav .item-nav {
    display: inline-block;
    height: 56rpx;
    line-height: 56rpx;
    text-align: center;
    font-size: 23rpx;
    color: #333333;
}

.swiper-nav .active {
    color: #fff;
    font-weight: bold;
}

.tab-line {
    position: absolute;
    left: 0;
    top: 0;
    transition: all 0.3s;
    z-index: -1;
}

.tab-line view {
    width: 80%;
    margin: 0 auto;
    background: #ff678e;
    height: 56rpx;
    border-radius: 56rpx;
}

.nolist {
    text-align: center;
    padding-top: 300rpx;
}

.nolist image {
    width: 176rpx;
    height: 182rpx;
}

.tishi {
    font-size: 30rpx;
    color: #b0b3bf;
    margin-top: 35rpx;
}

.tishi text {
    color: #ff6075;
}

page {
    width: 100%;
    height: 100%;
}

.container {
    width: 100%;
    height: 100%;
}

.tab-box {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
}

.tab-content {
    overflow-y: scroll;
}

.gg {
    width: 702rpx;
    float: left;
    border: 1px solid #eff2f4;
    margin-bottom: 21rpx;
    border-radius: 14rpx;
    background: #ffcbe0;
}
/* 分类二 */
.swiper_nav_bg {
    position: relative;
    height: 96rpx;
    width: 100%;
    z-index: 99;
    background: #fff;
    background-color: #fff;
    white-space: nowrap;
    -webkit-tap-highlight-color: rgba(0,0,0,0);
}

.swiper-navs.fixed {
    position: fixed;
}

.swiper-navs {
    width: 100%;
    box-sizing: border-box;
    position: absolute;
    left: 0;
    padding: 20rpx 22rpx;
    z-index: 99;
    background: #fff;
    background-color: #fff;
    white-space: nowrap;
    -webkit-tap-highlight-color: rgba(0,0,0,0);
}

.swiper-navs .item-nav {
    position: relative;
    display: inline-block;
    height: 56rpx;
    line-height: 56rpx;
    text-align: center;
    border-radius: 55rpx;
    font-size: 28rpx;
    color: #333333;
    margin-right: 49rpx;
    margin-left: 29rpx;
}

.swiper-navs .active {
    color: #ff5581;
    font-size: 38rpx;
}
.tab_line.active {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 6rpx;
    background: #ff5581;
}