<import src="../common/loading.wxml"></import>

<block wx:if="{{!isloading}}">
    <view>

        <index-attention show_name="{{show_name}}" showAddMeBtn="{{showAddMeBtn}}" countDownNum="{{countDownNum}}"></index-attention>
        <jingxihonbao bgShow="{{bgShow}}" isBag="{{isBag}}" receive="{{receive}}"></jingxihonbao>
        <!-- 轮播图 -->

   <view class="ad" wx:if="{{mode != 0 && config_base_list.advertisements.index_video_ad && vip !='1' && config_base_list.Other_switches.position == 1}}">
            <ad unit-id="{{config_base_list.advertisements.index_video_ad}}" ad-type="video" ad-theme="white"></ad>
        </view>

        <view bindtap="tipKeFuMsg" class="gonggao" wx:if="{{config_base_list.home_notice}}">
            <index-notice loop icon="tongzhi" speed="6000" backgroundcolor="#f1f1f1" color="#6A5ACD">
                {{config_base_list.home_notice}}
            </index-notice>
        </view>
        <!-- 格子广告 -->
        <!-- <view>
        <ad unit-id="adunit-c60f78b15cf31a4e" ad-type="grid" grid-opacity="0.8" grid-count="5" ad-theme="white"></ad></view> -->
        <view class="analysis">
            <view class="input-box">
                <input maxlength="-1" bindinput="pageUrlInput" placeholder="点击此处输入视频分享链接" value="{{pageUrl}}"></input>
                <icon wx:if="{{pageUrl.length > 0}}" class="clear-icon" bindtap="clearInput" color="#8a8a8a" size="32" type="guanbi1"></icon>
            </view>
            <view bindtap="xiafa_SubscribeMessage" class="analysis-btn" hover-class='analysis-btn-hover'>解析</view>
        </view>
        <template is="qsy-loading" data wx:if="{{isAnalyseLoading}}"></template>
        <view class="card" wx:if="{{videoInfo}}">
            <block wx:if="{{videoInfo.title}}">
                <view class="card-header" bindlongpress="Copy_video_info" bindtap="Copy_video_info" data-content="{{videoInfo.title}}" data-tip="标题已复制">
                    {{videoInfo.title}}
                </view>
            </block>
            <view class="card-body">
                <view style="padding-bottom:30rpx;">
                    <view class="c-minheight wx-view_tyb3Ns">
                        <view class="c-minheight wx-view_bRKuyf">
                            <view wx:if="{{videoInfo.url||videoInfo.quality}}" bindtap="changeShowtype" data-type="0" class="c-minheight wx-view_BGLGPk {{showtype==0?'choose-view':''}}">
                                <text class="c-block wx-text_fizACx {{showtype==0?'choose-text':''}}">视频下载</text>
                            </view>
                            <view wx:if="{{videoInfo.cover||videoInfo.atlas}}" bindtap="changeShowtype" data-type="1" class="c-minheight wx-view_3cPWb5 {{showtype==1?'choose-view':''}}">
                                <text class="c-block wx-text_PEajnu {{showtype==1?'choose-text':''}}">图片下载</text>
                            </view>
                            <view wx:if="{{videoInfo.title}}" bindtap="changeShowtype" data-type="2" class="c-minheight wx-view_3cPWb5 {{showtype==2?'choose-view':''}}">
                                <text class="c-block wx-text_PEajnu {{showtype==2?'choose-text':''}}">标题复制</text>
                            </view>
                        </view>
                    </view>
                    <!-- ad-unit-id="adunit-81729bc08be32bdd" -->
                    <block wx:if="{{showtype==0}}">
                        <video wx:if="{{videoInfo.url}}" src='{{videoInfo.url}}' poster='{{videoInfo.cover}}' title='{{videoInfo.title}}' style='width: 100%;height:126px;' bindlongpress="Copy_video_info" data-content="{{videoInfo.cover}}" data-tip="图片链接已复制"></video>
                        <block wx:if="{{video_quality}}">
                            <view style="display:flex;justify-content:space-between;margin-top:28rpx;margin-bottom:28rpx;">
                                <view style="height:88rpx;line-height:78rpx;text-align:center;border-radius:10rpx;font-size:28rpx;font-weight:400;color:#1296db;">
                                    <icon color="#1296db" size="75" type="zuan"></icon>
                                </view>
                                <picker style="-webkit-box-sizing: border-box;box-sizing:border-box;width:350rpx;height:88rpx;border:1px solid #d6d5d6;border-radius:10rpx;position:relative;" mode="selector" bindchange="bindPickerChange" value="{{pindex}}" range="{{video_quality}}" range-key="{{'filesize'}}">
                                    <view style="display:block;border:0;outline:none;font-size:28rpx;height:88rpx;line-height:88rpx;padding:0 60rpx 0 20rpx;">{{video_quality[pindex].level?video_quality[pindex].level+"("+video_quality[pindex].filesize+")":video_quality[pindex].filesize}}</view>
                                    <icon style="display:block;position:absolute;background-size:26rpx 26rpx;right:10rpx;top:50%;-webkit-transform:translateY(-50%);-ms-transform:translateY(-50%);transform:translateY(-50%);cursor:pointer;font-size:20rpx;" color="#000" size="20" type="xiala"></icon>
                                </picker>
                                <block wx:if="{{video_quality[pindex].url && video_quality[pindex].bigFile===false}}">
                                    <view style="width:180rpx;height:88rpx;line-height:88rpx;text-align:center;background:#39b54a;border-radius:10rpx;font-size:28rpx;font-weight:400;color:#fff;" bindtap="Download" data-type="video" data-line="0" data-link="{{video_quality[pindex].url}}"
                                        bindlongpress="Copy_video_info" data-content="{{video_quality[pindex].url}}" data-tip="视频链接已复制">下载</view>
                                </block>
                                <block wx:else>
                                    <view style="width:180rpx;height:88rpx;line-height:88rpx;text-align:center;background:rgb(249, 6, 6);border-radius:10rpx;font-size:28rpx;font-weight:400;color:#fff;" bindtap="Copy_video_info" data-content="{{video_quality[pindex].url}}" data-tip="视频链接已复制">复制</view>
                                </block>
                            </view>
                            <block wx:if="{{video_quality[pindex].bigFile===true}}">
                                <view class="bigFile-tips">由于该视频文件大小超出小程序下载限制，请复制视频地址后，用浏览器打开并下载：</view>
                                <view style="padding-bottom:20rpx;padding-top:20rpx;">
                                    <text class='frame'>安卓手机</text> 用户，建议您使用
                                    <text class='frame_filling'>QQ浏览器 </text> 或者
                                    <text class='frame_filling'>夸克浏览器</text> 下载视频
                                </view>
                                <view style="padding-bottom:20rpx;padding-top:20rpx;">
                                    <text class='frame'>苹果手机</text> 用户，建议您使用
                                    <text class='frame_filling'>Documents</text> 或者
                                    <text class='frame_filling'>文件全能王</text> 下载视频
                                </view>
                            </block>
                        </block>
                        <block wx:else>
                            <block wx:if="{{videoInfo.bigFile===false}}">
                                <block wx:if="{{videoInfo.url && videoInfo.down}}">
                                    <view class="down-video bg-blue" bindtap="Download" data-type="video" data-line="1" data-link="{{videoInfo.down}}" bindlongpress="Copy_video_info" data-content="{{videoInfo.url}}" data-tip="视频链接已复制">保存到相册(线路1，稳定)</view>
                                </block>
                                <block wx:if="{{videoInfo.url && videoInfo.fast_down}}">
                                    <view class="down-video bg-green" bindtap="Download" data-type="video" data-line="2" data-link="{{videoInfo.fast_down}}" bindlongpress="Copy_video_info" data-content="{{videoInfo.url}}" data-tip="视频链接已复制">保存到相册(线路2，极速)</view>
                                </block>
                            </block>
                            <block wx:else>
                                <view class="down-video bg-red" bindtap="Copy_video_info" data-content="{{videoInfo.url}}" data-tip="视频地址已复制">复制视频地址</view>
                            </block>
                            <block wx:if="{{videoInfo.bigFile===true}}">
                                <view class="bigFile-tips">由于该视频文件大小超出小程序下载限制，请复制视频地址后，用浏览器打开并下载：</view>
                                <view style="padding-bottom:20rpx;padding-top:20rpx;">
                                    <text class='frame'>安卓手机</text> 用户，建议您使用
                                    <text class='frame_filling'>QQ浏览器 </text> 或者
                                    <text class='frame_filling'>夸克浏览器</text> 下载视频
                                </view>
                                <view style="padding-bottom:20rpx;padding-top:20rpx;">
                                    <text class='frame'>苹果手机</text> 用户，建议您使用
                                    <text class='frame_filling'>Documents</text> 或者
                                    <text class='frame_filling'>文件全能王</text> 下载视频
                                </view>
                            </block>
                        </block>
                    </block>
                    <block wx:if="{{showtype==1}}">
                        <view class="c-minheight wx-view_tyb3Ns">
                            <view class="c-minheight wx-view_bRKuyf">
                                <view bindtap="change_cover_tab" data-type="0" class="c-minheight wx-view_BGLGPk {{cover_tab==0?'choose-view':''}}">
                                    <text class="c-block wx-text_fizACx {{cover_tab==0?'choose-text':''}}">封面下载</text>
                                </view>
                                <view wx:if="{{videoInfo.atlas}}" bindtap="change_cover_tab" data-type="1" class="c-minheight wx-view_BGLGPk {{cover_tab==1?'choose-view':''}}">
                                    <text class="c-block wx-text_fizACx {{cover_tab==1?'choose-text':''}}">整体下载</text>
                                </view>
                                <view wx:if="{{videoInfo.atlas}}" bindtap="change_cover_tab" data-type="2" class="c-minheight wx-view_BGLGPk {{cover_tab==2?'choose-view':''}}">
                                    <text class="c-block wx-text_fizACx {{cover_tab==2?'choose-text':''}}">选择下载</text>
                                </view>
                            </view>
                        </view>
                        <block wx:if="{{cover_tab==0}}">
                            <view class="photo_one flex_center">
                                <image alt="" class="photo_img" mode="aspectFit" src="{{videoInfo.cover}}"></image>
                            </view>
                            <view class="down-video bg-blue" bindtap="Download" data-type="image" data-line="{{cover_tab}}">保存图片到相册</view>
                        </block>
                        <block wx:if="{{cover_tab==1}}">
                            <view class="photo_one flex_center">
                                <swiper bindchange="changePhoto" circular="{{true}}" indicatorActiveColor="#F82741" indicatorDots="{{true}}">
                                    <swiper-item wx:for="{{photoList}}" wx:key="photoList1">
                                        <image class="slide-image" mode="scaleToFill" src="{{item.img_url}}"></image>
                                    </swiper-item>
                                </swiper>
                            </view>
                            <view class="down-video bg-blue" bindtap="Download" data-type="image" data-line="{{cover_tab}}">保存全部图片到相册</view>
                        </block>
                        <block wx:if="{{cover_tab==2}}">
                            <view class="photo_list">
                                <view bindtap="choosePhoto" class="photo_item" data-index="{{index}}" wx:for="{{photoList}}" wx:key="photoList2">
                                    <image alt="" class="photo_img" mode="scaleToFill" src="{{item.img_url}}"></image>
                                    <view class="choose_icon">
                                        <image alt="" src="../../images/choose_no.png" wx:if="{{!item.status}}"></image>
                                        <image alt="" src="../../images/choose_yes.png" wx:else></image>
                                    </view>
                                </view>
                            </view>
                            <view class="down-video bg-blue" bindtap="Download" data-type="image" data-line="{{cover_tab}}">保存选中图片</view>
                        </block>
                    </block>
                    <block wx:if="{{showtype==2}}">
                        <view class="c-minheight">
                            <text class="c-block wx-text_aaFbA1" style="padding:15px">{{videoInfo.title}}</text>
                        </view>
                        <view class="down-video bg-blue" bindtap="title_copy">复制标题</view>
                    </block>

                    <view wx:if="{{config_base_list.contact.Analytic_display1 && config_base_list.contact.Analytic_display2}}" bindtap="qqquncopy" class="qqqun_relief">
                        {{config_base_list.contact.Analytic_display1}}
                    </view>
                    <view class="down-video bg-blue" bindtap="previewImage">赞赏下作者 赞赏提个速</view>

                    <!-- <view class="down-video bg-blue" bindtap="video_xiugai">点击前往“视频修改”</view>
                    <view class="down-tips">视频修改(目前支持功能：提取视频声音、删除视频声音、去掉视频水印、提取视频水印、裁剪视频大小、添加片头尾)</view> -->

                    <!-- banner广告 -->
                    <!-- <view class="ad" wx:if="{{mode != 0 && config_base_list.advertisements.BannerAD_ID && vip !='1'}}">
                        <ad unit-id="{{config_base_list.advertisements.BannerAD_ID}}"></ad>
                    </view> -->
                    <view class="down-tips">
                        <text>{{config_base_list.foot_text}}</text>
                    </view>


                </view>
            </view>
        </view>
        <view class="panel">
            <view class="panel-view">
                <view class="title-view">
                    <view class="line"></view>
                    <view class="">常见问题 ● 更多功能</view>
                </view>
                <view class="box">
                    <view class="panle3">
                        <navigator class="nav" url="/pages/batch/batch">
                            <view class="header">
                                <view class="title">
                                    <text class="text">批量去水印</text>
                                </view>
                                <view>
                                    <text class="tip">更方便去水印~</text>
                                </view>
                                <view class="link">
                                    <em>查看 ></em>
                                </view>
                            </view>
                            <view class="img">
                                <icon class="icon" color="#fff" size="80" type="iconfonticon-shebei"></icon>
                            </view>
                        </navigator>
                    </view>
                    <view class="panle2">
                        <button bindtap="previewImage" target="miniProgram" open-type="navigate" class="nav" style="margin: 0;padding: 0;border-radius: 0;-webkit-tap-highlight-color: transparent;font-size: inherit;text-align: inherit;text-decoration: none;line-height: inherit;">
                            <view class="header">
                                <view class="title">
                                    <text class="text">赞赏作者</text>
                                </view>
                                <view>
                                    <text class="tip">给服务器提提速吧</text>
                                </view>
                                <view class="link">
                                    <em>查看 ></em>
                                </view>
                            </view>
                            <view class="img">
                                <icon class="icon" color="#fff" size="80" type="zan1"></icon>
                            </view>
                        </button>
                    </view>
                </view>
                <view class="box">
                    <view class="panle1">
                        <navigator bindtap="goxiugai" class="nav">
                            <view class="header">
                                <view class="title">
                                    <text class="text">视频修改</text>
                                </view>
                                <view>
                                    <text class="tip">后期处理视频必备</text>
                                </view>
                                <view class="link">
                                    <em>查看 ></em>
                                </view>
                            </view>
                            <view class="img">
                                <icon class="icon" color="#fff" size="80" type="bilibili-line"></icon>
                            </view>
                        </navigator>
                    </view>
                    <view class="panle4">
                        <navigator class="nav" url="/pages/question/question?into=question-copy">
                            <view class="header">
                                <view class="title">
                                    <text class="text">使用教程</text>
                                </view>
                                <view>
                                    <text class="tip">如何去除水印</text>
                                </view>
                                <view class="link">
                                    <em>查看 ></em>
                                </view>
                            </view>
                            <view class="img">
                                <icon class="icon" color="#fff" size="80" type="wenda"></icon>
                            </view>
                        </navigator>
                    </view>
                </view>
                <view class="box">
                    <view class="panle5">
                        <navigator class="nav" url="/pages/question/question?into=question-md5">
                            <view class="header">
                                <view class="title">
                                    <text class="text">MD5说明</text>
                                </view>
                                <view>
                                    <text class="tip">改MD5上热门</text>
                                </view>
                                <view class="link">
                                    <em>查看 ></em>
                                </view>
                            </view>
                            <view class="img">
                                <icon class="icon" color="#fff" size="80" type="bulb"></icon>
                            </view>
                        </navigator>
                    </view>
                    <view class="panle6">
                        <navigator wx:if="{{config_base_list.user_information.invite == '1'}}" class="nav" style="margin: 0;padding: 0;border-radius: 0;-webkit-tap-highlight-color: transparent;font-size: inherit;text-align: inherit;text-decoration: none;line-height: inherit;"
                            url="/pages/mine/invite/invite">
                            <view class="header">
                                <view class="title">
                                    <text class="text">邀请好友</text>
                                </view>
                                <view>
                                    <text class="tip">发家致富机会来了</text>
                                </view>
                                <view class="link">
                                    <em>查看 ></em>
                                </view>
                            </view>
                            <view class="img">
                                <icon class="icon" color="#fff" size="80" type="zhifeiji"></icon>
                            </view>
                        </navigator>

                        <button class="nav" style="margin: 0;padding: 0;border-radius: 0;-webkit-tap-highlight-color: transparent;font-size: inherit;text-align: inherit;text-decoration: none;line-height: inherit;" openType="share" wx:else>

                            <view class="header">
                                <view class="title">
                                    <text class="text">邀请好友</text>
                                </view>
                                <view>
                                    <text class="tip">发家致富机会来了</text>
                                </view>
                                <view class="link">
                                    <em>查看 ></em>
                                </view>
                            </view>
                            <view class="img">
                                <icon class="icon" color="#fff" size="80" type="zhifeiji"></icon>
                            </view>
                        </button>
                    </view>

                </view>
            </view>
        </view>
    


    </view>

    <view class="relief">
        <text>{{config_base_list.foot_text}}</text>
    </view>



    <view wx:if="{{config_base_list.Other_switches.shelter}}" class="comp-fixed-menu {{scrollTop?'comp-fixed-menu-show':'comp-fixed-menu-hide'}}">
        <button bindtap="_eventbackToTop" class="item" style="background:{{touming==1?'rgba(255, 255, 255, 0.49)':'#fff'}}">
            <icon color="#e36e24" size="26" type="fanhuidingbu"></icon>
            <view class="text">顶部</view>
        </button>
        <button bindtap="qiandao" class="item item-bg-1 item-1">
            <icon color="#fff" size="26" type="douyintexiao"></icon>
            <view class="text">签到</view>
        </button>
        <button showMessageCard class="item item-bg-2 item-2" openType="contact">
            <icon color="#fff" size="26" type="kefu"></icon>
            <view class="text">客服</view>
        </button>
        <button bindtap="goquestion" class="item item-bg-3 item-3">
            <icon color="#fff" size="26" type="wenda"></icon>
            <view class="text">帮助</view>
        </button>
        <button bindtap="onClose1" class="item item-bg-4 item-4">
            <icon color="#fff" size="26" type="rightarrow"></icon>
            <view class="text">收起</view>
        </button>
    </view>

    <!--index-menu hidden id='menu' bind:addEvent="_addEvent" bind:deleteLotsEvent="_deleteLotsEvent" /-->
    <view class="Pop-ups {{modalName=='MessageModal'?'show':''}} ">
        <view class="dialog">
            <view class="bar">
                <view class="action">
                    <view class="content">提示信息</view>
                </view>
            </view>
            <view style="padding:50rpx;">
                {{message}}
            </view>
            <view class="bar">
                <view class="action">
                    <button bindtap="hideModal" class="Pop-btn" style="background-color:#0081FF;color:#fff;">朕知道了</button>
                </view>
            </view>
        </view>
    </view>
    <view class="Pop-ups {{modalName=='downloadProcessModal'?'show':''}}">
        <view class="dialog">
            <view class="bar">
                <view class="content">下载进度：{{downloadProcess}}%</view>
            </view>
            <view style="background-color:#fff;color:#666;padding-left:30rpx;padding-right:30rpx;">
                <view class="progress round striped active" style="margin-top:30rpx;margin-bottom:30rpx;">
                    <view style="width:{{downloadProcess}}%;background-color:#39b54a"></view>
                </view>
            </view>
            <view class="bar">
                <view class="action">
                    <button bindtap="hideModal" class="Pop-btn" style="background-color:#0081FF;color:#fff;">隐藏下载进度</button>
                </view>
            </view>
            <view style="white-space:pre-wrap;font-size: 28rpx;color: #000;line-height: 48rpx;">苹果手机进度条不显示是正常的，如长时间进度0%也等等 {{config_base_list.contact.reservation_msg}}
            </view>
            <!-- 格子广告 -->
            <!-- <view class="ad" wx:if="{{config_base_list.advertisements.chaping}}">
      <ad unit-id="{{config_base_list.advertisements.chaping}}" ad-type="grid" grid-opacity="0.8" grid-count="5" ad-theme="white"></ad>
    </view> -->

        </view>
    </view>
    <view wx:if="{{config_base_list.Other_switches.modalName}}" class="Pop-ups {{modalName=='clipboardUrlDetected'?'show':''}} ">
        <view class="dialog">
            <view class="bar">
                <view class="content">检测到视频分享链接</view>
            </view>
            <view style="padding:50rpx;">
                {{tempClipboardData}}
            </view>
            <view class="bar">
                <view bindtap="hideModal" class="action" style="color:#39b54a;">我不</view>
                <view bindtap="clipboard_qsy" class="action" style="color:#0081ff;">解析</view>
            </view>
        </view>
    </view>
</block>
<template is="index-loading" data wx:if="{{isloading}}"></template>