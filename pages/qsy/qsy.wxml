              </view>
              <view class="img">
                <icon class="icon" color="#fff" size="80" type="zan1"></icon>
              </view>
            </button>
          </view>
        </view> -->
        <view class="box">
          <view class="panle1">
            <navigator bindtap="goxiugai" class="nav">
              <view class="header">
                <view class="title">
                  <text class="text">视频修改</text>
                </view>
                <view>
                  <text class="tip">后期处理视频必备</text>
                </view>
                <view class="link">
                  <em>查看 ></em>
                </view>
              </view>
              <view class="img">
                <icon class="icon" color="#fff" size="80" type="bilibili-line"></icon>
              </view>
            </navigator>
          </view>
          <view class="panle4">
            <navigator class="nav" url="/pages/question/question?into=question-copy">
              <view class="header">
                <view class="title">
                  <text class="text">使用教程</text>
                </view>
                <view>
                  <text class="tip">如何去除水印</text>
                </view>
                <view class="link">
                  <em>查看 ></em>
                </view>
              </view>
              <view class="img">
                <icon class="icon" color="#fff" size="80" type="wenda"></icon>
              </view>
            </navigator>
          </view>
        </view>
        <view class="box">
          <view class="panle5">
            <navigator class="nav" url="/pages/question/question?into=question-md5">
              <view class="header">
                <view class="title">
                  <text class="text">MD5说明</text>
                </view>
                <view>
                  <text class="tip">改MD5上热门</text>
                </view>
                <view class="link">
                  <em>查看 ></em>
                </view>
              </view>
              <view class="img">
                <icon class="icon" color="#fff" size="80" type="bulb"></icon>
              </view>
            </navigator>
          </view>
          <view class="panle6">
            <navigator wx:if="{{config_base_list.user_information.invite == '1'}}" class="nav" style="margin: 0;padding: 0;border-radius: 0;-webkit-tap-highlight-color: transparent;font-size: inherit;text-align: inherit;text-decoration: none;line-height: inherit;" url="/pages/mine/invite/invite">
              <view class="header">
                <view class="title">
                  <text class="text">邀请好友</text>
                </view>
                <view>
                  <text class="tip">发家致富机会来了</text>
                </view>
                <view class="link">
