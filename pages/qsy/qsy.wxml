<import src="../common/loading.wxml"></import>

<block wx:if="{{!isloading}}">
  <view>

    <jingxihonbao bgShow="{{bgShow}}" isBag="{{isBag}}" receive="{{receive}}"></jingxihonbao>
    <!-- 轮播图 -->

    <view class="ad" wx:if="{{mode != 0 && config_base_list.advertisements.index_video_ad && vip !='1' && config_base_list.Other_switches.position == 1}}">
      <ad unit-id="{{config_base_list.advertisements.index_video_ad}}" ad-type="video" ad-theme="white"></ad>
    </view>

    <view class="gonggao" wx:if="{{config_base_list.home_notice}}">
      <index-notice loop icon="tongzhi" speed="6000" backgroundcolor="#f1f1f1" color="#6A5ACD">
        {{config_base_list.home_notice}}
      </index-notice>
    </view>
    <!-- 格子广告 -->
    <!-- <view>
        <ad unit-id="adunit-c60f78b15cf31a4e" ad-type="grid" grid-opacity="0.8" grid-count="5" ad-theme="white"></ad></view> -->
    <view class="analysis">
      <view class="input-box">
        <input maxlength="-1" bindinput="pageUrlInput" placeholder="点击此处输入视频分享链接" value="{{pageUrl}}"></input>
        <icon wx:if="{{pageUrl.length > 0}}" class="clear-icon" bindtap="clearInput" color="#8a8a8a" size="32" type="guanbi1"></icon>
      </view>
      <view bindtap="qsy" class="analysis-btn" hover-class='analysis-btn-hover'>解析</view>
    </view>
    <template is="qsy-loading" data wx:if="{{isAnalyseLoading}}"></template>
    <view class="card" wx:if="{{qsyInfo.url || qsyInfo.images.length>0}}">
      <block wx:if="{{qsyInfo.title}}">
        <view class="card-header" bindlongpress="save_resources" bindtap="save_resources" data-url="{{qsyInfo.title}}" data-type="copy" data-tip="标题已复制">
          {{qsyInfo.title}}
        </view>
      </block>
      <view class="card-body">
        <view style="padding-bottom:30rpx;">
          <view class="c-minheight wx-view_tyb3Ns">
            <view class="c-minheight wx-view_bRKuyf">
              <view wx:if="{{qsyInfo.url}}" bindtap="changeShowtype" data-type="0" class="c-minheight wx-view_BGLGPk {{showtype==0?'choose-view':''}}">
                <text class="c-block wx-text_fizACx {{showtype==0?'choose-text':''}}">视频下载</text>
              </view>
              <view wx:if="{{qsyInfo.cover||qsyInfo.images}}" bindtap="changeShowtype" data-type="1" class="c-minheight wx-view_3cPWb5 {{showtype==1?'choose-view':''}}">
                <text class="c-block wx-text_PEajnu {{showtype==1?'choose-text':''}}">图片下载</text>
              </view>
              <view wx:if="{{qsyInfo.title}}" bindtap="changeShowtype" data-type="2" class="c-minheight wx-view_3cPWb5 {{showtype==2?'choose-view':''}}">
                <text class="c-block wx-text_PEajnu {{showtype==2?'choose-text':''}}">标题复制</text>
              </view>
            </view>
          </view>
          <!-- ad-unit-id="adunit-81729bc08be32bdd" -->
          <block wx:if="{{showtype==0}}">
            <video wx:if="{{qsyInfo.url}}" src='{{qsyInfo.url}}' poster='{{qsyInfo.cover}}' title='{{qsyInfo.title}}' style='width: 100%;height:126px;'></video>
            <block wx:if="{{video_list.length>0}}">
              <view style="margin-top:28rpx;margin-bottom:28rpx;">
                <view style="height:88rpx;line-height:78rpx;color:#1296db;font-size: 20px;">
                  画质选择
                </view>
                <picker style="-webkit-box-sizing: border-box;box-sizing:border-box;width:100%;height:88rpx;border:1px solid #d6d5d6;border-radius:10rpx;position:relative;" mode="selector" bindchange="bindPickerChange" value="{{qualityIndex}}" range="{{video_list}}" range-key="{{'level'}}">
                  <view style="display:block;border:0;outline:none;font-size:28rpx;height:88rpx;line-height:88rpx;padding:0 60rpx 0 20rpx;">{{video_list[qualityIndex].level}}</view>
                  <icon style="display:block;position:absolute;background-size:26rpx 26rpx;right:10rpx;top:50%;-webkit-transform:translateY(-50%);-ms-transform:translateY(-50%);transform:translateY(-50%);cursor:pointer;font-size:20rpx;" color="#000" size="20" type="xiala"></icon>
                </picker>
                <!-- <block wx:if="{{video_list[qualityIndex].url && video_list[qualityIndex].size<= 1024*1024*100 }}">
                  <view style="width:180rpx;height:88rpx;line-height:88rpx;text-align:center;background:#39b54a;border-radius:10rpx;font-size:28rpx;font-weight:400;color:#fff;" bindtap="save_resources" data-type="video" data-url="{{video_list[qualityIndex].url}}" data-tip="视频链接已复制">下载</view>
                </block>
                <block wx:else>
                  <view style="width:180rpx;height:88rpx;line-height:88rpx;text-align:center;background:rgb(249, 6, 6);border-radius:10rpx;font-size:28rpx;font-weight:400;color:#fff;" bindtap="save_resources" data-type="copy" data-url="{{video_list[qualityIndex].url}}" data-tip="视频链接已复制">复制</view>
                </block> -->
              </view>
              <!-- <block wx:if="{{video_list[qualityIndex].size> 1024*1024*100 }}">
                <view class="bigFile-tips">由于该视频文件大小超出小程序下载限制，请复制视频地址后，用浏览器打开并下载：</view>
                <view style="padding-bottom:20rpx;padding-top:20rpx;">
                  <text class='frame'>安卓手机</text> 用户，建议您使用
                  <text class='frame_filling'>QQ浏览器 </text> 或者
                  <text class='frame_filling'>夸克浏览器</text> 下载视频
                </view>
                <view style="padding-bottom:20rpx;padding-top:20rpx;">
                  <text class='frame'>苹果手机</text> 用户，建议您使用
                  <text class='frame_filling'>Documents</text> 或者
                  <text class='frame_filling'>文件全能王</text> 下载视频
                </view>
              </block> -->
            </block>

            <block wx:if="{{qsyInfo.url}}">
              <view class="down-video bg-blue" bindtap="save_resources" data-type="video" data-line="1" data-url="{{qsyInfo.url}}"  data-tip="视频链接已复制">保存到相册</view>
            </block>
            <block wx:if="{{ qsyInfo.url }}">
              <view class="down-video bg-green" bindtap="save_resources" data-type="video" data-url="{{qsyInfo.url}}"  data-tip="视频链接已复制">保存到相册(备用)</view>
            </block>
            <block>
              <view class="down-video bg-red" bindtap="save_resources" data-type="copy" data-url="{{qsyInfo.url}}" data-content="{{qsyInfo.url}}" data-tip="视频地址已复制">复制视频地址</view>
            </block>
            <block wx:if="{{qsyInfo.size>1024*1024*50}}">
              <view class="bigFile-tips">由于该视频文件大小超出小程序下载限制，请复制视频地址后，用浏览器打开并下载：</view>
              <view style="padding-bottom:20rpx;padding-top:20rpx;">
                <text class='frame'>安卓手机</text> 用户，建议您使用
                <text class='frame_filling'>QQ浏览器 </text> 或者
                <text class='frame_filling'>夸克浏览器</text> 下载视频
              </view>
              <view style="padding-bottom:20rpx;padding-top:20rpx;">
                <text class='frame'>苹果手机</text> 用户，建议您使用
                <text class='frame_filling'>Documents</text> 或者
                <text class='frame_filling'>文件全能王</text> 下载视频
              </view>
            </block>
          </block>
          <block wx:if="{{showtype==1}}">
            <view class="c-minheight wx-view_tyb3Ns">
              <view class="c-minheight wx-view_bRKuyf">
                <view bindtap="change_cover_tab" data-type="0" class="c-minheight wx-view_BGLGPk {{cover_tab==0?'choose-view':''}}">
                  <text class="c-block wx-text_fizACx {{cover_tab==0?'choose-text':''}}">封面下载</text>
                </view>
                <view wx:if="{{qsyInfo.images.length>0}}" bindtap="change_cover_tab" data-type="1" class="c-minheight wx-view_BGLGPk {{cover_tab==1?'choose-view':''}}">
                  <text class="c-block wx-text_fizACx {{cover_tab==1?'choose-text':''}}">整体下载</text>
                </view>
                <view wx:if="{{qsyInfo.images.length>0}}" bindtap="change_cover_tab" data-type="2" class="c-minheight wx-view_BGLGPk {{cover_tab==2?'choose-view':''}}">
                  <text class="c-block wx-text_fizACx {{cover_tab==2?'choose-text':''}}">选择下载</text>
                </view>
              </view>
            </view>
            <block wx:if="{{cover_tab==0}}">
              <view class="photo_one flex_center">
                <image alt="" class="photo_img" mode="aspectFit" src="{{qsyInfo.cover}}"></image>
              </view>
              <view class="down-video bg-blue" bindtap="save_resources" data-type="image" data-url="{{qsyInfo.cover}}">保存图片到相册</view>
            </block>
            <block wx:if="{{cover_tab==1}}">
              <view class="photo_one flex_center">
                <swiper bindchange="changePhoto" circular="{{true}}" indicatorActiveColor="#F82741" indicatorDots="{{true}}">
                  <swiper-item wx:for="{{form_images}}" wx:key="form_images1">
                    <image class="slide-image" mode="scaleToFill" src="{{item.img_url}}"></image>
                  </swiper-item>
                </swiper>
              </view>
              <view class="down-video bg-blue" bindtap="save_resources" data-type="images">保存全部图片到相册</view>
            </block>
            <block wx:if="{{cover_tab==2}}">
              <view class="photo_list">
                <view bindtap="choosePhoto" class="photo_item" data-index="{{index}}" wx:for="{{form_images}}" wx:key="form_images2">
                  <image alt="" class="photo_img" mode="scaleToFill" src="{{item.img_url}}"></image>
                  <view class="choose_icon">
                    <image alt="" src="../../images/choose_no.png" wx:if="{{!item.status}}"></image>
                    <image alt="" src="../../images/choose_yes.png" wx:else></image>
                  </view>
                </view>
              </view>
              <view class="down-video bg-blue" bindtap="save_resources" data-type="form_images" data-line="{{cover_tab}}">保存选中图片</view>
            </block>
          </block>
          <block wx:if="{{showtype==2}}">
            <view class="c-minheight">
              <text class="c-block wx-text_aaFbA1" style="padding:15px">{{qsyInfo.title}}</text>
            </view>
            <view class="down-video bg-blue" bindtap="title_copy">复制标题</view>
          </block>

          <view wx:if="{{config_base_list.contact.Analytic_display1 && config_base_list.contact.Analytic_display2}}" bindtap="qqquncopy" class="qqqun_relief">
            {{config_base_list.contact.Analytic_display1}}
          </view>

          <!-- <view class="down-video bg-blue" bindtap="video_xiugai">点击前往“视频修改”</view>
                    <view class="down-tips">视频修改(目前支持功能：提取视频声音、删除视频声音、去掉视频水印、提取视频水印、裁剪视频大小、添加片头尾)</view> -->

          <!-- banner广告 -->
          <!-- <view class="ad" wx:if="{{mode != 0 && config_base_list.advertisements.BannerAD_ID && vip !='1'}}">
                        <ad unit-id="{{config_base_list.advertisements.BannerAD_ID}}"></ad>
                    </view> -->
          <view class="down-tips">
            <text>{{config_base_list.foot_text}}</text>
          </view>


        </view>
      </view>
    </view>
    <view class="panel">
      <view class="panel-view">
        <view class="title-view">
          <view class="line"></view>
          <view class="">常见问题 ● 更多功能</view>
        </view>
        <!-- <view class="box">
          <view class="panle3">
            <navigator class="nav" url="/pages/batch/batch">
              <view class="header">
                <view class="title">
                  <text class="text">批量去水印</text>
                </view>
                <view>
                  <text class="tip">更方便去水印~</text>
                </view>
                <view class="link">
                  <em>查看 ></em>
                </view>
              </view>
              <view class="img">
                <icon class="icon" color="#fff" size="80" type="iconfonticon-shebei"></icon>
              </view>
            </navigator>
          </view>
          <view class="panle2">
            <button bindtap="previewImage" target="miniProgram" open-type="navigate" class="nav" style="margin: 0;padding: 0;border-radius: 0;-webkit-tap-highlight-color: transparent;font-size: inherit;text-align: inherit;text-decoration: none;line-height: inherit;">
