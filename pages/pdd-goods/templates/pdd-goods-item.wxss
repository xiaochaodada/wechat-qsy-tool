.pdd-goods-item-container {
    width: 718rpx;
    box-sizing: border-box;
    padding: 32rpx 0;
    background-color: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2rpx solid #E6E6E6;
}

.pdd-goods-item-container.insert1 {
    border-bottom: 0!important;
}

.pdd-goods-item-container.insert2 {
    padding-top: 0!important;
    border-bottom: 0!important;
}

.pdd-goods-item-container.insert3 {
    padding: 0!important;
    border-bottom: 0!important;
}

.pdd-goods-item-container-goods-image {
    width: 250rpx;
    height: 250rpx;
}

.pdd-goods-item-container-right-container {
    min-width: 450rpx;
    height: 250rpx;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.pdd-goods-item-container-goods-name {
    max-width: 452rpx;
    color: #333;
    font-size: 34rpx;
    line-height: 52rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-weight: bold;
}

.pdd-goods-item-container-discounts-container {
    color: #999;
    font-size: 24rpx;
    line-height: 56rpx;
    margin-top: 22rpx;
}

.pdd-goods-item-container-discounts-prize {
    color: #f43530;
    font-size: 34rpx;
    line-height: 54rpx;
    font-weight: bold;
}

.pdd-goods-item-container-discounts-prize-number {
    font-size: 52rpx;
}

.pdd-goods-item-container-original-prize {
    text-decoration: line-through;
}

.pdd-goods-item-container-sold-quantity {
    margin-left: 16rpx;
}

.pdd-goods-item-container-bottom-container {
    max-width: 452rpx;
    display: flex;
    align-items: end;
    justify-content: space-between;
}

.pdd-goods-item-container-ticket-prize {
    color: #f43530;
    display: flex;
    align-items: flex-end;
}

.price-sympol {
    display: inline-block;
    font-size: 30rpx;
    line-height: 56rpx;
    height: 56rpx;
}

.pdd-goods-item-container-ticket-prize-number {
    display: inline-block;
    font-size: 52rpx;
    line-height: 66rpx;
}

.pdd-goods-item-container-go-shopping-button {
    width: 248rpx;
    height: 64rpx;
    border-radius: 32rpx;
    background-color: #ff5c5c;
    color: white;
    font-size: 30rpx;
    line-height: 64rpx;
    margin: 0;
    padding: 0;
}

/* login */
.qusian {
    width: 100%;
    height: 70rpx;
    background: #eee;
    display: flex;
    align-items: center;
    justify-content: center;
}
.qusian image {
    width: 35rpx;
    height: 35rpx;
}