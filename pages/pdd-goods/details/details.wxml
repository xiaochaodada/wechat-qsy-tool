<view class="zong">
    <view class="swipbod">
        <!-- <view bindtap="fanhui" class="fanhui">
            <image class="left_imga" src="../../../images/left.png"></image>
        </view> -->
        <swiper class="swiper">
            <swiper-item wx:for="{{goods.goods_gallery_urls}}"wx:key="goods_id">
                <image class="swiper_img" src="{{item}}"></image>
            </swiper-item>
        </swiper>
    </view>
    <view class="details">
        <view class="Commodity">
            <text class="pin">拼</text>
            <text class="wen">{{goods.goods_name}}</text>
        </view>
        <view class="price">
            <view class="price_one">
                <text class="shisyf">¥{{(goods.min_group_price-goods.coupon_discount)/100}}</text>
                <text class="shisyf_one">券后价</text>
                <text class="yuan">原价¥{{goods.min_group_price/100}}</text>
            </view>
            <text class="yifgh">已拼{{goods.sales_tip}}单</text>
        </view>
    </view>
    <view class="beijg"></view>
    <view class="coupon">
        <view bindtap="mai" class="coupon_one">
            <image class="coupon_oneimg" src="../../../images/coupon.png"></image>
            <view class="lijqu">
                <view class="youhui">
                    <text>{{goods.coupon_discount/100}}元优惠券</text>
                    <text>有效期：{{goods.coupon_start_time}}-{{goods.coupon_end_time}}</text>
                </view>
                <text class="most">立即领券</text>
            </view>
        </view>
        <view class="sdhulian">
      优惠券剩余数量：{{goods.coupon_remain_quantity}}/{{goods.coupon_total_quantity}}
    </view>
    </view>
    <view class="beijg"></view>
    <view class="details" style="margin-bottom:150rpx;">
        <view class="backzieo">
            <view class="Commodity">
                <text class="pin">推荐</text>
                <text class="wen">{{goods.goods_desc}}</text>
            </view>
        </view>
        <image class="xiangqiimg" src="{{item}}" wx:for="{{goods.goods_gallery_urls}}"wx:key="goods_id"></image>
    </view>
</view>
