<view class="xaigag">
    <view bindtap="home_pages" class="return">
        <image src="../../../images/home_page.png"></image>
        <text>首页</text>
    </view>
   
    <button openType="share" class="qhcb">
        <image src="../../../images/fenxiang.png"></image>
        <text>分享好友购买</text>
        </button>

    <navigator appId="{{goods.pdd_app_id}}" class="qhcb addcolr" extraData="" hoverClass="none" openType="navigate" path="{{goods.pdd_page_path}}" target="miniProgram" version="release">
        <image src="../../../images/jine.png"></image>
        <text>立即领券购买</text>
    </navigator>
</view>
