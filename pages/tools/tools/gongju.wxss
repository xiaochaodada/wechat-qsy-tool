/* 工具类 */
gongjupage {
    line-height: 1.6;
    font-family: -apple-system-font,Helvetica Neue,sans-serif;
}
.china70th {
    position: fixed;
    z-index: -1;
    opacity: 0.05;
    width: 100%;
    height: 100%;
}
.weui-cells__title {
    margin-top: 0.77em;
    margin-bottom: 0.3em;
    padding-left: 15px;
    padding-right: 15px;
    color: #999;
    font-size: 14px;
}
.weui-grids {
    border-top: 1rpx solid #d9d9d9;
    border-left: 1rpx solid #d9d9d9;
    overflow: hidden;
}

.weui-grid_active {
    background-color: #ececec;
}

.weui-grid__icon {
    display: block;
    width: 36px;
    height: 36px;
    margin: 0 auto;
}
.weui-grid__label {
    margin-top: 5px;
    display: block;
    text-align: center;
    color: #000;
    font-size: 14px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}
.weui-grid {
    position: relative;
    float: left;
    padding: 20px 10px;
    width: 33.33333333%;
    box-sizing: border-box;
    border-right: 1rpx solid #d9d9d9;
    border-bottom: 1rpx solid #d9d9d9;
}
