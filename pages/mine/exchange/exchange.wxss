}

.mine .mine-header .task-desc-2 {
    color: rgb(169,173,175);
    font-size: 22rpx;
    vertical-align: middle;
    position: relative;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    align-items: center;
    line-height: 44rpx;
    margin-top: 4rpx;
}

.mine .mine-header .task-score {
    color: #fb8358;
}

.mine .mine-header .finish-avatar {
    width: 100rpx;
    height: 100rpx;
    border-radius: 100rpx;
    position: relative;
    overflow: hidden;
    padding-right: 20rpx;
    margin-bottom: 60rpx;
}

.finish-span {
    font-size: 28rpx;
    line-height: 42rpx;
    color: #444;
}

.task-do-avatar {
    width: 30rpx;
    height: 30rpx;
    border-radius: 30rpx;
    position: relative;
    overflow: hidden;
    padding-right: 14rpx;
    margin-bottom: -5rpx;
}

.task-do-span {
    font-size: 26rpx;
    color: #fff;
}

.task-btn {
    position: relative;
    margin-right: -15rpx;
    background-color: #ffa533;
    border-radius: 50rpx;
    right: 0;
    padding-left: 20rpx;
    padding-right: 20rpx;
    font-size: 1px;
}

.resource-row {
    width: 100%;
    box-sizing: border-box;
}

.resource-row .row-item {
    width: 331rpx;
    height: 390rpx;
    position: relative;
    padding: 28rpx 32rpx;
    box-sizing: border-box;
    display: inline-block;
    vertical-align: top;
    margin-bottom: 24rpx;
    overflow: hidden;
    border-radius: 20rpx;
}

.resource-row .row-item:nth-child(odd) {
    margin-right: 24rpx;
}

.resource-row .row-item:nth-last-child(-n+2) {
    margin-bottom: 0;
}

.resource-row .row-item .item-bg {
    width: 100%;
    height: 331rpx;
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 20rpx;
}

.resource-row .row-item .item-title {
    position: absolute;
    font-size: 28rpx;
    color: black;
    line-height: 44rpx;
    margin-bottom: 4rpx;
    bottom: 0;
    width: 100%;
    text-align: center;
    left: 0;
}

.resource-row .row-item .item-desc {
    position: relative;
    font-size: 24rpx;
    color: #888888;
    line-height: 36rpx;
}

.resource-row .row-item .icon-arrow {
    position: absolute;
    width: 14rpx;
    height: 24rpx;
    top: 88rpx;
    right: 24rpx;
}

.resource-row .row-item .icon-arrow image {
    width: 14rpx;
    height: 24rpx;
}