.nav {
    width: 100%;
    overflow: hidden;
    position: relative;
    top: 0;
    left: 0;
    z-index: 10;
}

.nav-title {
    font-weight: 500;
    width: 100%;
    height: 45px;
    line-height: 45px;
    text-align: left;
    padding-left: 40rpx;
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 10;
    font-family: PingFang-SC-Medium;
    font-size: 36rpx;
    letter-spacing: 2px;
}

.nav .back {
    width: 30px;
    height: 30px;
    position: absolute;
    bottom: -3px;
    left: 0;
    padding: 10px 15px;
}

.bg-white {
    background-color: #ffffff;
}

.bg-gray {
    background-color: #ffffff;
}

.overflow {
    overflow: auto;
}

.hidden {
    overflow: hidden;
}

body {
    background: white;
}

.page-header .header-inner .page-title {
    font-size: 38rpx;
    font-weight: 500;
}

.follow-banner-container.with-margin {
    margin: 24rpx 32rpx 48rpx 32rpx;
}

.mine {
    box-sizing: border-box;
    margin-top: 32rpx;
}

.mine .no-margin {
    margin: 0;
}

.mine .header-card {
    margin-bottom: 24rpx;
    border-radius: 20rpx;
    background: #F4F5F9;
    margin: 0 32rpx 32rpx 32rpx;
}

.mine .header-card .item-desc {
    right: 32rpx;
}

.mine .ad-card {
    margin-bottom: 24rpx;
    background: #F4F5F9;
    margin: 0 32rpx 32rpx 32rpx;
}

.mine .mine-header {
    padding: 40rpx 32rpx 24rpx 32rpx;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    align-items: center;
    position: relative;
}

.mine .mine-header.active {
    background-color: #1a7cff;
}

.mine .mine-header .user-avatar {
    width: 112rpx;
    height: 112rpx;
    border-radius: 112rpx;
    position: relative;
    overflow: hidden;
    padding-right: 24rpx;
}

.mine .mine-header .user-avatar image {
    display: none;
    width: 112rpx;
    height: 112rpx;
    border-radius: 112rpx;
    overflow: hidden;
}

.mine .mine-header .user-avatar image.show {
    display: inline-block;
}

.mine .mine-header .user-avatar .default-avatar {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
}

.mine .mine-header .user-avatar .login-avatar {
    position: absolute;
    z-index: 2;
}

.mine .mine-header .header-content {
    -webkit-box-flex: 1;
    flex-grow: 1;
    padding: 8rpx 0 4rpx 0;
}

.mine .mine-header .header-title {
    max-width: 500rpx;
    font-size: 34rpx;
    line-height: 52rpx;
    font-weight: bold;
    margin-bottom: 0;
}

.mine .mine-header .header-desc {
    color: #7C878E;
    font-size: 28rpx;
    vertical-align: middle;
    position: relative;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    align-items: center;
    line-height: 44rpx;
    margin-top: 4rpx;
}

.mine .mine-header .header-desc .verify-badge {
    position: static;
    transform: none;
    margin-left: 16rpx;
    height: 40rpx;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    align-items: center;
    font-weight: bold;
}

.mine .mine-header .header-desc .verify-badge.status-muted {
    background: #7C878E;
}

.mine .item-desc {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    align-items: center;
    position: absolute;
    height: 100%;
    top: 0;
    right: 40rpx;
}

.mine .item-desc .desc-content {
    display: inline-block;
    font-size: 28rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 300rpx;
}

.mine .item-desc .desc-arrow {
    height: 24rpx;
    width: 14rpx;
    margin-left: 20rpx;
}

.mine .spinner {
    margin-top: 0;
}

.mine .top-items {
    box-sizing: border-box;
    text-align: center;
}

.mine .top-items .row-item {
    padding: 24rpx 0 40rpx 0;
    position: relative;
}

.mine .top-items .row-item:last-of-type::after {
    display: none;
}

.mine .top-items .row-item .top-item-icon {
    width: 48rpx;
    height: 48rpx;
    vertical-align: middle;
}

.mine .top-items .row-item .item-value {
    line-height: 64rpx;
    font-size: 44rpx;
    max-width: 250rpx;
    margin-bottom: 4rpx;
}

.mine .top-items .row-item .item-title {
    font-size: 28rpx;
    color: #7c878e;
    line-height: 44rpx;
}

.mine .top-items .row-item .hint-point {
    position: absolute;
    right: 50rpx;
    top: 30rpx;
}

.functional-card {
    margin: 0 32rpx 32rpx 32rpx;
}

.functional-card .functional-row {
    overflow: hidden;
}

.functional-card .functional-row .row-item {
    width: 25%;
    float: left;
    box-sizing: border-box;
    padding: 24rpx 0;
    text-align: center;
}

.functional-card .functional-row .row-item .item-body .item-icon {
    display: block;
    margin: 0 auto 16rpx;
    width: 64rpx;
    height: 64rpx;
}

.functional-card .functional-row .row-item .item-body .title {
    font-size: 28rpx;
}

.functional-card .functional-row .row-item .hint-point.top-right {
    top: 30rpx;
    right: 30rpx;
}

.functional-card .functional-row .row-item .badge.align-top-right {
    top: 20rpx;
    right: 20rpx;
}

.inline-card {
    margin-top: 24rpx;
}

.inline-card .inline-card-item {
    font-size: 28rpx;
    position: relative;
    padding-left: 40rpx;
    background-color: #fff;
    height: 112rpx;
    line-height: 112rpx;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    align-items: center;
    width: 100%;
}

.inline-card .inline-card-item .item-title {
    display: inline-block;
    font-size: 32rpx;
    line-height: 1.5;
}

.inline-card .inline-card-item .item-desc {
    color: #888;
    white-space: nowrap;
}

.inline-card .inline-card-item .point-left {
    margin-left: 450rpx;
}

.inline-card .item-divider {
    border-top: 1rpx solid #e5e5e5;
    height: 0;
}

.inline-card .item-tips {
    position: absolute;
    right: 84rpx;
    white-space: nowrap;
}

.inline-card .item-tips.gray-text {
    color: #C1C6C8;
}

.inline-card .mfa-item {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    align-items: center;
}

.inline-card .mfa-item .mfa-countdown {
    height: 42rpx;
    width: 30rpx;
}

.inline-card .mfa-item .mfa-countdown .mfa-countdown-bar {
    height: 6rpx;
    margin-bottom: 6rpx;
}

.inline-card .mfa-item .mfa-countdown .mfa-countdown-bar:last-of-type {
    margin-bottom: 0;
}

.inline-card .mfa-item .item-token {
    font-size: 44rpx;
    margin-left: 30rpx;
}

.follow-wechat-icon {
    width: 40rpx;
    height: 40rpx;
    margin-left: 16rpx;
}

.des-title {
    font-size: 24rpx;
    color: #888;
    line-height: 44rpx;
}

.pt10 {
    padding-top: 10rpx;
}

.pt20 {
    padding-top: 20rpx;
}

.info-card {
    background-color: #fff;
}

.info-card:last-of-type {
    padding-bottom: 30rpx;
}

.info-card swiper-item {
    border-radius: 20rpx;
}

.info-card .card-header {
    padding: 48rpx 40rpx 32rpx;
    position: relative;
    box-sizing: border-box;
}

.info-card .card-header .padding-bottom-0 {
    padding-bottom: 0;
}

.info-card .card-header .card-title {
    font-size: 36rpx;
    color: #000;
    line-height: 45rpx;
    font-weight: 500;
    position: relative;
}

.info-card .card-header .title-more {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    padding: 10rpx;
    right: 0;
    display: inline-block;
    font-size: 28rpx;
    color: #888;
}

.info-card .card-body {
    padding: 0 32rpx;
}

.info-card .card-body .no-padding {
    padding: 0;
}

.mine .mine-header .task-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 80rpx;
    position: relative;
    overflow: hidden;
    padding-right: 24rpx;
}

.mine .mine-header .task-avatar image {
    display: none;
    width: 80rpx;
    height: 80rpx;
    border-radius: 80rpx;
    overflow: hidden;
}

.mine .mine-header .task-avatar image.show {
    display: inline-block;
}

.mine .mine-header .task-avatar .default-avatar {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
}

.mine .mine-header .task-title {
    max-width: 500rpx;
    font-size: 28rpx;
    line-height: 42rpx;
    font-weight: bold;
    margin-bottom: 0;
}

.mine .mine-header .task-desc {
    color: #444;
    font-size: 24rpx;
    vertical-align: middle;
    position: relative;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    align-items: center;
    line-height: 44rpx;
