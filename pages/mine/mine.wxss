page {
    background: #f5f5f5;
}

.title {
    height: 32px;
    line-height: 32px;
    font-size: 44rpx;
    font-weight: bold;
    margin-top: 12rpx;
    padding-left: 30rpx;
}

button {
    position: relative;
    display: block;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border-radius: 0;
    -webkit-tap-highlight-color: transparent;
    font-size: inherit;
    text-align: inherit;
    text-decoration: none;
    line-height: inherit;
    overflow: hidden;
    color: inherit;
    background-color: inherit;
}

button::after {
    border: none;
}

.center {
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    flex-direction: column;
}

.center .blue-top {
    width: 750rpx;
    height: 260rpx;
    background: #00c8fd;
    border-radius: 0 0 350rpx 350rpx / 0 0 30rpx 30rpx;
    margin-bottom: 160rpx;
}

.center .blue-top .user-card {
    box-sizing: border-box;
    width: 686rpx;
    height: 360rpx;
    background: #fff;
    position: absolute;
    left: 50%;
    transform: translate(-50%,28rpx);
    border-radius: 20rpx;
}

.center .blue-top .user-card .card-top {
    box-sizing: border-box;
    border-bottom: 1px solid #eee;
    height: 220rpx;
    position: relative;
}

.center .blue-top .user-card .card-top .user-top {
    width: 100%;
    position: absolute;
    top: -26rpx;
}

.center .blue-top .user-card .card-top .user-top .user-vip {
    width: 130rpx;
    height: 130rpx;
    margin: 0 auto;
}

.center .blue-top .user-card .card-top .user-top .user-vip .user-pic {
    overflow: hidden;
    display: block;
    width: 130rpx;
    height: 130rpx;
    border-radius: 50%;
    margin: 0 auto;
    background: #999;
}

.center .blue-top .user-card .card-top .user-top .user-board {
    width: 100%;
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
    margin-top: 40rpx;
}

.center .blue-top .user-card .card-top .user-top .user-board .user-name {
    color: #1f1f1f;
    font-size: 36rpx;
    font-weight: bold;
}

.center .blue-top .user-card .card-top .user-top .user-board .vip-icon {
    display: block;
    width: 44rpx;
    height: 44rpx;
    margin-left: 17rpx;
    margin-top: 2rpx;
}

.center .blue-top .user-card .card-bottom {
    box-sizing: border-box;
    height: 140rpx;
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    text-align: center;
    padding: 18rpx 0;
}

.center .blue-top .user-card .card-bottom .left {
    width: 33%;
    border-right: 1px solid #eee;
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    flex-direction: column;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
}

.center .blue-top .user-card .card-bottom .center {
    width: 33%;
    border-right: 1px solid #eee;
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    flex-direction: column;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
}

.center .blue-top .user-card .card-bottom .right {
    width: 33%;
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    flex-direction: column;
    -webkit-box-pack: center;
    -ms-flex-pack: center;
    justify-content: center;
}

.center .blue-top .user-card .card-bottom .count {
    color: #999;
    font-size: 36rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
}

.center .blue-top .user-card .card-bottom .count .num {
    color: #00c8fd;
    display: inline;
}

.center .blue-top .user-card .card-bottom .txt {
    color: #1f1f1f;
    font-size: 24rpx;
}

.center-list {
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    background-color: #fff;
    margin-top: 20rpx;
    width: 686rpx;
    -webkit-box-orient: vertical;
    -webkit-box-direction: normal;
    flex-direction: column;
    margin: 0 auto;
    border-radius: 20rpx;
    overflow: hidden;
}

.center-list-item {
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    height: 80rpx;
    width: 686rpx;
    box-sizing: border-box;
    -webkit-box-orient: horizontal;
    -webkit-box-direction: normal;
    flex-direction: row;
    padding: 0rpx 32rpx;
    border-bottom-width: 1px;
    border-color: #eee;
    border-bottom-style: solid;
}

.center-list-item:last-child {
    border-bottom: 0;
}

.center-list-item .icon1 {
    display: block;
    height: 80rpx;
    width: 50rpx;
    line-height: 80rpx;
    background-position: center center;
    background-repeat: no-repeat;
    background-size: 50rpx 50rpx;
    color: #00c8fd;
    text-align: left;
    margin-right: 18rpx;
}

.list-text {
    height: 80rpx;
    line-height: 80rpx;
    color: #1f1f1f;
    -webkit-box-flex: 1;
    flex: 1;
    text-align: left;
    font-size: 28rpx;
}

.icon2 {
    display: block;
    height: 80rpx;
    width: 40rpx;
    line-height: 80rpx;
    color: #8a8a8a;
    text-align: right;
}

.relief {
    font-size: 24rpx;
    color: #999;
    text-align: center;
    padding: 30rpx 0;
}

.poster {
    top: 0;
    left: 0;
    z-index: 10;
    width: 100%;
    height: 100%;
    display: flex;
    position: fixed;
    padding: 50px 20px;
    text-align: center;
    box-sizing: border-box;
    flex-direction: column;
    justify-content: center;
    background-color: #0000006b;
    transition: all 1s;
}

.poster>text {
    color: white;
    text-shadow: 1px 1px 5px rgba(0,0,0,0.459);
}

.poster>.tips {
    font-size: 12px;
    color: #fbfbfb;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
}

.poster image {
    width: 90%;
    margin: 10px auto 2px;
    border-radius: 10px;
    display: inline-block;
    box-shadow: 0 0 10px -5px #f5c1e56b;
}

.poster>view {
    display: flex;
    margin-top: 8px;
    align-items: center;
    justify-content: center;
}

.poster button {
    color: white;
    background: #64bafa;
    height: 36px;
    margin: 0 25px;
    padding: 0 35px;
    font-size: 17px;
    line-height: 36px;
    border-radius: 20px;
}

.poster .icon-close {
    width: 32px;
    height: 32px;
    line-height: 32px;
    border-radius: 50%;
    text-align: center;
    background-color: white;
}

@-webkit-keyframes showMaster {
    0% {
        opacity: 0;
    }

    100% {
        opacity: 1;
    }
}

@keyframes showMaster {
    0% {
        opacity: 0;
    }

    100% {
        opacity: 1;
    }
}

.an-show-p {
    animation: showMaster 0.6s ease;
}

@-webkit-keyframes showIn {
    0%,35%,70%,to {
        animation-timing-function: cubic-bezier(0.215,0.61,0.355,1);
    }

    0% {
        opacity: 0;
        transform: scale3d(0.3,0.3,0.3);
    }

    35% {
        transform: scale3d(1.1,1.1,1.1);
    }

    70% {
        transform: scale3d(0.9,0.9,0.9);
    }

    to {
        opacity: 1;
        transform: scaleX(1);
    }
}

@keyframes showIn {
    0%,35%,70%,to {
        animation-timing-function: cubic-bezier(0.215,0.61,0.355,1);
    }

    0% {
        opacity: 0;
        transform: scale3d(0.3,0.3,0.3);
    }

    35% {
        transform: scale3d(1.1,1.1,1.1);
    }

    70% {
        transform: scale3d(0.9,0.9,0.9);
    }

    to {
        opacity: 1;
        transform: scaleX(1);
    }
}

.an-show {
    animation: showIn 0.7s;
}

.custom-dialog .blurbg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
}

.custom-dialog .blurbg>image {
    width: 100%;
    height: 320rpx;
    transition: 0.6s all;
}

.custom-dialog .weui-dialog__hd {
    padding-top: 345rpx;
}

.custom-dialog .weui-dialog__ft::after {
    border-top: none;
}

.custom-dialog .custom-dialog__tips {
    margin-top: 30rpx;
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    text-align: left;
}

.custom-dialog .custom-dialog__tips>text {
    flex: 1;
    font-size: 26rpx;
    color: rgba(0,0,0,0.43);
    position: relative;
    padding-left: 1.5em;
    margin-bottom: 10rpx;
}

.custom-dialog .custom-dialog__tips>text::before {
    content: '';
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    vertical-align: middle;
    background-color: rgba(0,0,0,0.14);
    display: inline-block;
    margin: 0 10rpx;
    position: absolute;
    top: 11rpx;
    left: 0.2em;
}

/* 四宫格 */

.nav-container {
    display: flex;
    padding: 14rpx 0 14rpx;
    align-items: center;
    justify-content: space-around;
    border-radius: 10rpx;
    margin-bottom: 22rpx;
    box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.05);
    background: #fff;
}

.nav-container button.nav-block {
    flex: 1;
    display: flex;
    margin: 0 6rpx;
    padding: 8rpx 0;
    min-width: 120rpx;
    border-radius: 10rpx;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    transition: 0.8s opacity, 0.25s background-color;
}

.nav-container .nav-block.nav-block-hover {
    background-color: #fccedb4b;
}

.nav-container .nav-block text.iconfont {
    color: #f85e8a;
    font-size: 50rpx;
    line-height: 50rpx;
    margin-bottom: 4rpx;
}

.nav-container .nav-block text.iconqiandao {
    font-weight: normal;
}

.index-bd {
    padding: 0rpx 30rpx 10rpx;
}

@import "../mine/icon/icon.wxss";