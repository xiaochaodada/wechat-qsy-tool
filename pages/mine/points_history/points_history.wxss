.bg {
    background: linear-gradient(to bottom right,#ff567a,#ff2679);
    height: 360rpx;
    width: 100%;
}
.text-center {
    text-align: center;
}
.padding-top {
    padding-top: 30rpx;
}
.text-white,.line-white,.lines-white {
    color: #fff;
}
.padding-top-xl {
    padding-top: 50rpx;
}
.text-sm {
    font-size: 24rpx;
}

.text-xsl {
    font-size: 120rpx;
}
.text-sm {
