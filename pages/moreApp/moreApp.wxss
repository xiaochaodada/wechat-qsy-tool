view {
  box-sizing: border-box;
}

page {
  background-color: #f3f2f2;
}

.main {
  padding: 40rpx 30rpx;
}



.more_game .games .item {
  margin-bottom: 32rpx;
  width: 100%;
  height: 180rpx;
  border-radius: 24rpx;
  display: flex;
  padding: 30rpx;
  background: #ffffff;
  align-items: center;
  box-shadow: 0px 2rpx 4pux 0px rgba(0,0,0,0.06);
}



.more_game .games .item .logo image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #eee;
}

.more_game .games .item .desc {
  padding-left: 30rpx;
  flex: 1;
}

.more_game .games .item .desc .first {
  font-size: 30rpx;
  color: rgba(33,33,33,1);
}

.more_game .games .item .desc .third {
  font-size: 26rpx;
  color: rgba(153,153,153,1);
}

.more_game .games .item .button {
  width: 140rpx;
  border-radius: 36rpx;
  height: 72rpx;
  background: #4b81fa;
}

.more_game .games .item .button .b {
  width: 140rpx;
  height: 68rpx;
  border-radius: 36rpx;
  background: #5b8dfd;
  font-size: 28rpx;
  color: #ffffff;
  line-height: 68rpx;
  text-align: center;
}