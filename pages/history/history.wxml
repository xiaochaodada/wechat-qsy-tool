<view class="no-data" wx:if="{{!list||list.length==0}}">暂无相关信息~</view>
<view class="container">
    <view class="scroll-gap"></view>
    <view wx:if="{{list && list.length > 0}}">
        <text>当前下载记录共:{{list.length}}(默认保留最新15个视频记录)~</text>
    </view>
    <view class="video-box shadow" wx:for="{{list}}" wx:key="{{index}}">
        <view class="video-btm">
            <view class="video-title ellipsis" bindtap="Copy_video_info" bindlongpress="Copy_video_info" data-content="{{item.title}}" data-tip="标题已复制">{{item.title}}</view>
            <button data-content="{{item}}" openType="share">
                <icon color="#9cf" size="30" type="share"></icon>
            </button>
        </view>
        <video autoplay class="video-item" bindlongpress="Copy_video_info" data-content="{{item.cover}}" data-tip="图片链接已复制" poster="{{item.cover}}" src="{{item.video}}" wx:if="{{index===downloadIndex}}"></video>
        <view class="video-cover" wx:else>
            <image class="video-cover-poster" mode="aspectFit" src="{{item.cover}}" bindtap="Copy_video_info" bindlongpress="Copy_video_info" data-content="{{item.cover}}" data-tip="图片链接已复制"></image>
            <icon bindtap="videoPlay" data-idx="{{index}}" class="video-cover-icon" color="#00c8fd" size="55" type="bofang"></icon>
            <text class="video-date">{{item.date}}</text>
        </view>
        <view class="btn">
            <button class="btn-left" bindtap="Copy_video_info" bindlongpress="Copy_video_info" data-content="{{item.url}}" data-tip="视频地址已复制">复制链接</button>
            <button class="btn-center" bindtap="Download" data-link="{{item.url}}">重新下载</button>
            <button class="btn-right" bindtap="DEL" data-key="{{index}}">删除记录</button>
        </view>
    </view>
    <view class="scroll-gap"></view>
</view>