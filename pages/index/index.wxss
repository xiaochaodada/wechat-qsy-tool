@import "../common/loadings.wxss";
@import './main.wxss';

.banner-pic {
    display: block;
    width: 100%;
    height: 290rpx;
}

.mini-btn {
    margin-right: 0rpx;
    padding: 0 14rpx!important;
    margin-bottom: 2rpx;
}
.setIcon {
    width: 170rpx;
    height: 50rpx;
}
.img_h {
    height: 25px;
    width: 25px;
}

page {
    background: #fff;
}

.small-msg {
    width: 160px;
    background: #b2b2b2;
}

.listBanner {
    border-radius: 10rpx;
    background: #343547;
    padding: 10rpx;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    -webkit-align-items: center;
    align-items: center;
    -webkit-box-pack: justify;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.vip {
    color: #f9dad0;
    font-size: 32rpx;
}

.vipWord {
    font-size: 28rpx;
    color: #fff;
}

.vipPrivilege {
    color: #8383a2;
    font-size: 24rpx;
}

.clearfix:after {
    visibility: hidden;
    display: block;
    font-size: 0;
    content: " ";
    clear: both;
    height: 0;
}

.listItem {
    padding: 20rpx;
    width: calc(49% - 10rpx);
    color: #fff;
    margin-bottom: 40rpx;
    float: left;
    border-radius: 10rpx;
}

.listItem:nth-child(2n) {
    margin-left: 20rpx;
}

.listItem:nth-child(odd) {
    margin-left: 1%;
}

.firstHead {
    font-size: 34rpx;
    margin-bottom: 20rpx;
    display: block;
    font-weight: 600;
}

.nowBody {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-pack: start;
    -webkit-justify-content: flex-start;
    justify-content: flex-start;
    -webkit-box-align: stretch;
    -webkit-align-items: stretch;
    align-items: stretch;
}

.headImg {
    width: 70rpx;
    height: 70rpx;
}

.bg9C8EFD {
    background: #9c8efd;
}

.bgFFC078 {
    background: #ffc078;
}

.bg67BAFC {
    background: #67bafc;
}

.bgFE9786 {
    background: #fe9786;
}

.bottomItem {
    padding: 20rpx;
    width: calc(49% - 10rpx);
    color: #fff;
    margin-bottom: 40rpx;
    float: left;
    border-radius: 10rpx;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-pack: start;
    -webkit-justify-content: flex-start;
    justify-content: flex-start;
    -webkit-box-align: center;
    -webkit-align-items: center;
    align-items: center;
    border: 1px solid #ccc;
    border-radius: 20rpx;
}

.bottomItem:nth-child(2n) {
    margin-left: 20rpx;
}

.bottomImg {
    width: 60rpx;
    height: 60rpx;
    display: inline-block;
    margin-right: 1rpx;
}

.bottomOne {
    color: #fff;
}

.bottomTwo {
    color: #fff;
}

.pic-padding {
    padding: 4px;
    margin-left: 0rpx;
}

.tower-swiper .tower-item {
    -webkit-transform: scale(calc(0.5 + var(--index) / 10));
    transform: scale(calc(0.5 + var(--index) / 10));
    margin-left: calc(var(--left) * 100rpx - 150rpx);
    z-index: var(--index);
}

.water-teach {
    text-align: center;
    margin-top: 10px;
}

.sub-title {
    font-size: 24rpx;
    color: #7a7a7a;
    padding-top: 18rpx;
}

.tui-nickname {
    font-size: 30rpx;
    font-weight: 500;
    color: #13227a;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    -webkit-align-items: center;
    align-items: center;
    -webkit-box-pack: center;
    -webkit-justify-content: center;
    justify-content: center;
    text-decoration: underline;
}

.share-btn {
    color: red;
    background: #000;
    font-size: 30rpx;
    font-weight: 500;
}

.tui-img-vip {
    width: 60rpx;
    height: 30rpx;
    margin-right: 18rpx;
}

.tui-notice-board {
    width: 100%;
    padding-right: 30rpx;
    box-sizing: border-box;
    font-size: 28rpx;
    height: 48rpx;
    background: grey;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-align: center;
    -webkit-align-items: center;
    align-items: center;
    top: 0;
    z-index: 999;
}

.tui-icon-bg {
    background: grey;
    padding-left: 30rpx;
    position: relative;
    z-index: 10;
}

.tui-icon-class {
    margin-right: 12rpx;
}

.tui-scorll-view {
    -webkit-box-flex: 1;
    -webkit-flex: 1;
    flex: 1;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    color: #fff;
}

.tui-notice {
    -webkit-transform: translateX(100%);
    transform: translateX(100%);
}

.tui-animation {
    -webkit-animation: tui-rolling 12s linear infinite;
    animation: tui-rolling 12s linear infinite;
}

@-webkit-keyframes tui-rolling {
    0% {
        -webkit-transform: translateX(100%);
        transform: translateX(100%);
    }

    to {
        -webkit-transform: translateX(-170%);
        transform: translateX(-170%);
    }
}

@keyframes tui-rolling {
    0% {
        -webkit-transform: translateX(100%);
        transform: translateX(100%);
    }

    to {
        -webkit-transform: translateX(-170%);
        transform: translateX(-170%);
    }
}

.tui-subject {
    padding: 100rpx 30rpx 30rpx 30rpx;
    box-sizing: border-box;
    font-size: 32rpx;
    font-weight: 700;
}

.shadow-blur {
    box-shadow: rgba(0, 0, 0, 0.3) 2rpx 4rpx 8rpx 2rpx;
}

.headImgWrap {
    display: -webkit-inline-box;
    display: -webkit-inline-flex;
    display: inline-flex;
    -webkit-box-pack: center;
    -webkit-justify-content: center;
    justify-content: center;
    -webkit-box-align: center;
    -webkit-align-items: center;
    align-items: center;
    padding: 10rpx 15rpx;
}

.headWord {
    padding: 40rpx 0 30rpx 30rpx;
}

.indexTitle {
    border-left: 8rpx solid #333;
    padding-left: 10rpx;
    color: #333;
    font-weight: 700;
    font-size: 34rpx;
    margin: 10rpx 20rpx 10rpx 0;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    -webkit-box-pack: justify;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    -webkit-box-align: center;
    -webkit-align-items: center;
    align-items: center;
    margin-left: 10rpx;
}
.cu-list.grid>.cu-item uni-text {
    color: #333;
}






.analysis {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  margin: 0 13rpx;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
  margin-top: 28rpx;
  margin-bottom: 28rpx;
}

.analysis .input-box {
  -webkit-box-sizing: border-box;
  box-sizing: border-box;
  width: 530rpx;
  height: 88rpx;
  border: 1px solid #d6d5d6;
  border-radius: 20rpx;
  position: relative;
}

.analysis .input-box wx-input {
  display: block;
  border: 0;
  outline: none;
  font-size: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 60rpx 0 20rpx;
}

.analysis .input-box .clear-icon {
  display: block;
  position: absolute;
  right: 10rpx;
  top: 50%;
  -webkit-transform: translateY(-50%);
  -ms-transform: translateY(-50%);
  transform: translateY(-50%);
  cursor: pointer;
}

.analysis .analysis-btn {
  width: 180rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #00c8fd;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.analysis .analysis-btn-hover {
  transform: translate(1rpx, 1rpx);
}
