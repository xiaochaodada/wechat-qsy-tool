.container {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 200rpx 0;
    box-sizing: border-box;
}

page {
    height: 100%;
    background-color: #2b2b2b;
}

.xf {
    bottom: 90%!important;
}

.wx-switch-input {
    width: 82rpx!important;
    height: 40rpx!important;
}

.wx-switch-input::before {
    width: 80rpx!important;
    height: 36rpx!important;
}

.wx-switch-input::after {
    width: 40rpx!important;
    height: 36rpx!important;
}

.second {
    background: #e5e5e5;
    color: #FFFFFF;
}

.section {
    background-color: #333333;
    font-size: 30rpx;
    width: 95%;
    height: 22vh;
    color: #bbbbbb;
    padding-left: 5%;
}

.chw {
    background-color: #333333;
    color: #bbbbbb;
    font-size: 30rpx;
    padding-left: 5%;
    height: 6vh;
}

.textstyle {
    background-color: #333333;
    font-size: 30rpx;
    width: 95%;
    height: 16vh;
    color: #bbbbbb;
    padding-left: 5%;
}

.result-style {
    background-color: #333333;
    font-size: 20px;
    width: 100%;
    height: 10vh;
    color: #e6e6e6;
    border-color: #333333;
}

.body-view {
    height: 7vh;
    line-height: 7vh;
    background-color: #2b2b2b;
    color: #e6e6e6;
    padding-left: 5%;
    font-size: 32rpx;
}

.btnGroup {
    display: flex;
    flex-direction: row;
}

.item {
    width: 25%;
    min-height: 10rpx;
    margin: 0rpx;
    border-radius: 0px;
    text-align: center;
    line-height: 15vh;
    display: inline-block;
    font-size: 40rpx;
}

.item2 {
    width: 50%;
    min-height: 0rpx;
    margin: 0rpx;
    border-radius: 0px;
    text-align: center;
    line-height: 15vh;
    display: inline-block;
}

.orange {
    color: #ebebeb;
    border: solid 1px #e7763e;
    background: #e7763e;
}

.normal {
    color: #ebebeb;
    border: solid 1px #444444;
    background-color: #333333;
}

.normal-orange {
    color: #f78d1d;
    border: solid 1px #444444;
    background-color: #333333;
}