page {
    background-color: #f5f5f5;
}

.btn {
    padding: 30rpx;
}

.container {
    padding: 30rpx 40rpx;
    border-radius: 16rpx;
    background-color: #fff;
    margin: 30rpx 30rpx 0;
}

.container>view {
    margin-bottom: 0;
}

.tip {
    text-align: center;
    font-size: 36rpx;
    font-weight: 700;
    margin-bottom: 20rpx;
}

.rowCon {
    margin: 30rpx 0;
    border-bottom: 1px solid #e0e0e0;
}

.rowCon text {
    font-size: 35rpx;
}

.rowCon_l {
    display: inline-block;
    margin-right: 10rpx;
}

.rowCon>text:last-child {
    float: right;
}

.top {
    background-color: #4dbf29;
    padding: 40px 0;
    display: flex;
    justify-content: center;
}

.top-info {
    border: 3px solid #fff;
    padding: 40rpx 20rpx;
    display: flex;
    flex-flow: column;
    align-items: center;
    color: #fff;
    width: 50%;
    font-weight: 700;
}

.phone-info {
    padding: 0 30rpx;
}

.bt1 {
    background: #4dbf29;
    color: #fff;
    font-size: 28rpx;
    line-height: 90rpx;
    border-radius: 10rpx;
    text-align: center;
}

.ali_color {
    color: #40a9ff;
    font-size: 12px;
    font-weight: 800;
}

.ali_copy {
    color: #40a9ff;
    font-weight: 800;
}

.zfbt {
    text-align: center;
    margin-top: 20rpx;
}