.container_input {
    width: 100%;
    display: flex;
    flex-direction: column;
}

.calculateBtn {
    width: 494rpx;
    height: 80rpx;
    background-image: linear-gradient(-180deg,rgba(255,255,255,0.08) 2%,rgba(255,255,255,0.12) 99%);
    box-shadow: 0 8rpx 0 0 rgba(0,0,0,0.08);
    border-radius: 200rpx;
    position: fixed;
    bottom: 64rpx;
    display: flex;
    justify-content: center;
    margin-left: 128rpx;
}

.calculateTxt {
    width: 334rpx;
    font-size: 28rpx;
    color: #fff;
    font-weight: 300;
    line-height: 28rpx;
    margin-top: 26rpx;
    display: flex;
    justify-content: center;
}

.calculateArrow {
    width: 32rpx;
    height: 32rpx;
    margin-top: 28rpx;
}

.mList {
    width: 100%;
    padding-top: 156rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.inputCell {
    width: 312rpx;
    display: flex;
    flex-direction: column;
}

.inputQuestions {
    font-size: 34rpx;
    color: #fff;
    letter-spacing: 1.6rpx;
    line-height: 34rpx;
    text-shadow: -4rpx 4rpx 0 rgba(0,0,0,0.12);
    margin-bottom: 16rpx;
}

.inputAnswers {
    width: 100%;
    height: 62rpx;
    font-size: 30rpx;
    color: rgba(255,255,255,0.48);
    line-height: 30rpx;
}

.inputLine {
    width: 100%;
    height: 2rpx;
    background-color: white;
    margin-bottom: 114rpx;
    background: linear-gradient(to right,rgba(255,255,255,0.32),rgba(255,255,255,0.08));
    border-radius: 2rpx;
}

.inputDate {
    width: 100%;
    height: 62rpx;
    font-size: 30rpx;
    color: rgba(255,255,255,0.6);
    line-height: 30rpx;
    display: flex;
    align-items: center;
}