.template_index {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.clock {
    width: 288rpx;
    height: 288rpx;
    position: relative;
    margin-top: 100rpx;
}

.clock_hour {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    animation: rotate 192s linear infinite;
}

.clock_minute {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    animation: rotate 16s linear infinite;
}

@-webkit-keyframes rotate {
    0% {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }
}

@keyframes rotate {
    0% {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }
}

.lifeclock {
    width: 45rpx;
    height: 224rpx;
    margin-top: 62rpx;
}

.bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
}

.tips {
    color: rgba(255,255,255,0.32);
    font-size: 30rpx;
    margin-bottom: 8rpx;
    font-weight: lighter;
}

.btn_test {
    height: 80rpx;
    margin-bottom: 64rpx;
    color: white;
    background-color: rgba(255,255,255,0.08);
    border-radius: 80rpx;
    line-height: 80rpx;
    margin-top: 24rpx;
    font-size: 28rpx;
    padding: 0 70rpx;
    font-weight: 300;
    box-shadow: 0 8rpx 0 0 rgba(0,0,0,0.08);
}