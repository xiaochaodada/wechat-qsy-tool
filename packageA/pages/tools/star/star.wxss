.container {
    position: relative;
    width: 100%;
}

.bg {
    height: 100vh !important;
}

.star {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
}

image {
    width: 100%;
    vertical-align: middle;
}

.splash {
    animation: splash 2s linear infinite backwards alternate;
}

@-webkit-keyframes splash {
    0% {
        opacity: 0;
    }

    100% {
        opacity: 1;
    }
}

@keyframes splash {
    0% {
        opacity: 0;
    }

    100% {
        opacity: 1;
    }
}

