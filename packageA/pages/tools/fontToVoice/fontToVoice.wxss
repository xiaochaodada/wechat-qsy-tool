page {
    padding: 0;
    margin: 0;
    font-size: 30rpx;
    color: #757575;
    background-color: #eee;
    width: 100%;
    height: 100%；;
}

.textarea {
    background-color: #fff;
    width: 720rpx;
    height: 450rpx;
    line-height: 60rpx;
    font-size: 30rpx;
    box-sizing: border-box;
    padding: 30rpx;
    margin: 20rpx 15rpx;
    border: none;
    box-shadow: 2rpx 2rpx 2rpx rgba(0,0,0,0.2);
    border-radius: 20rpx;
}

.button {
    appearance: none;
    box-sizing: border-box!important;
    width: 230rpx;
    font-size: 30rpx;
    margin-left: 15rpx;
    background-color: #3dcc79;
    border-radius: 4rpx;
    text-align: center;
    height: 80rpx;
    line-height: 80rpx;
    color: #fff;
    border: none;
    float: left;
}

.button::after {
    border: none;
}

.button-hover {
    background-color: #000;
    color: #fff;
}

.section {
    box-sizing: border-box;
    width: 720rpx;
    margin: 0 15rpx;
    margin-top: 15rpx;
    background-color: #fff;
    border: none;
    padding: 15rpx 30rpx;
    box-shadow: 0 1rpx 1rpx rgba(0,0,0,0.1);
    overflow: hidden;
    border-radius: 20rpx;
}

.section_title {
    box-sizing: border-box;
    font-size: 24rpx;
}

.section_input {
    text-align: center;
    box-sizing: border-box;
}

.action-sheet {
    width: 100%;
    height: 80rpx;
    line-height: 80rpx;
    box-sizing: border-box;
    overflow: hidden;
    text-align: center;
}

.action-sheet-hover {
    background-color: #3dcc79;
    color: #fff;
}