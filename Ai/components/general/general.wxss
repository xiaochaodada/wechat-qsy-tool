.outter {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.img {
    width: 96%;
    border-radius: 6rpx;
    padding: 12rpx 0;
    background-color: #fff;
    border-bottom: #e3e3e3 solid 1rpx;
    margin-bottom: 10rpx;
}

.inner {
    width: 100%;
    display: flex;
    flex-direction: row;
    background-color: #fff;
    padding: 0 20rpx;
    box-sizing: border-box;
}

.item {
    width: 100%;
    line-height: 88rpx;
    border-bottom: #e3e3e3 solid 1rpx;
    height: 88rpx;
    overflow: hidden;
}

.item_left {
    flex: 1;
    font-size: 34rpx;
}

.item_right {
    flex: 2;
    color: #5a5a5a;
    font-size: 32rpx;
}

.text_box {
    display: flex;
    flex-wrap: wrap;
    padding: 0 14rpx;
    margin-bottom: 10rpx;
}

.text_content {
    margin: 6rpx 12rpx;
    padding: 10rpx 20rpx;
    background-color: #fff;
    border-radius: 16rpx;
}